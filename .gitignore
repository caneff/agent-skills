# skills are the content; only build/deps artifacts are ignored
.claude/worktrees/
# installed deps, never committed. No trailing slash: also catches a
# `node_modules` symlink (a worktree pointing at the root install), which a
# dir-only `node_modules/` pattern would miss and leave untracked — that stray
# symlink is what blocks removing the worktree afterwards.
node_modules
# python bytecode, never source
__pycache__/
# local scratch: drafts, prototypes, throwaway notes — never committed
.scratch/
# the /implement lane's Rust crate: its build output, never committed.
flow/lane/target/
# a loaded mod's engine-written type files and tsconfig, regenerated on load
flow/mods/*/.claude-plugin/types/
flow/mods/*/tsconfig.json

# a venv `uv sync` builds from uv.lock, never committed
.venv/
