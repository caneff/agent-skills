# Sandbox image for a [% if LANGUAGE == 'node' %]Node (npm)[% else %]Python (uv)[% endif %] target repo. Runs the coding agent, git, gh,
# and the target's uv/just toolchain. main.mts runs on the HOST (via tsx) — it
# is never in this image; only the in-sandbox agent + its tools live here.
[% if LANGUAGE == 'node' %]FROM node:22-bookworm[% else %]FROM debian:bookworm-slim[% endif %]

# System dependencies
RUN apt-get update && apt-get install -y \
  git \
  curl \
  ca-certificates \
  jq \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

# Build-args for UID/GID alignment: sandcastle docker build-image defaults these
# to the host user's UID/GID so image-built files and bind-mounted files share
# an owner without runtime chown.
ARG AGENT_UID=1000
ARG AGENT_GID=1000

# Create the agent user aligned to the host UID/GID.
[% if LANGUAGE == 'node' %]RUN groupmod -o -g $AGENT_GID node \
  && usermod -o -u $AGENT_UID -g $AGENT_GID -d /home/agent -m -l agent node[% else %]RUN groupadd -o -g $AGENT_GID agent \
  && useradd -o -u $AGENT_UID -g $AGENT_GID -m -d /home/agent -s /bin/bash agent[% endif %]
USER ${AGENT_UID}:${AGENT_GID}

[% if LANGUAGE == 'python' %]# uv — manages Python per the target's .python-version. Installed as the agent
# user so it lands on the agent's PATH.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Bake the target's exact interpreter into an image LAYER so no container re-fetches
# it at run time. copier renders PYTHON_VERSION from the target's .python-version
# (recorded as a copier answer) when the template is installed.
ARG PYTHON_VERSION=[[ PYTHON_VERSION ]]
RUN /home/agent/.local/bin/uv python install ${PYTHON_VERSION}

# just — the target's task runner. The PR check-gate runs `just check` inside
# this image, so the binary must be on the agent's PATH (installed in-ecosystem
# via uv, matching how setup-python-repo installs it on the host).
RUN /home/agent/.local/bin/uv tool install rust-just
[% endif %]
# Claude Code CLI (standalone binary — not a Node app).
RUN curl -fsSL https://claude.ai/install.sh | bash

# uv + claude both install under ~/.local/bin
ENV PATH="/home/agent/.local/bin:$PATH"

WORKDIR /home/agent

# In worktree sandbox mode, Sandcastle bind-mounts the git worktree at
# /home/agent/workspace and overrides the working directory there at container start.
ENTRYPOINT ["sleep", "infinity"]
