{
  "name": "setup-sandcastle-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical dev home for the Sandcastle Python orchestrator. Hack here with tests green; the skill installs .sandcastle/ (minus tests) into target repos.",
