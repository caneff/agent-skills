  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.10.0",
    "@standard-schema/spec": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
