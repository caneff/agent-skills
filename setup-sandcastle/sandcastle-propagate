#!/usr/bin/env bash
# sandcastle-propagate [--dry-run] [REF]
#
# Push the Sandcastle template to every adopter repo, then commit + push each.
# Adopters are discovered, not listed: any repo under $SEARCH_ROOT with a
# .sandcastle/.copier-answers.yml breadcrumb pointing at caneff/agent-skills.
#
# Why `copier copy --overwrite` and not `copier update`: copier update is broken
# for this layout (the template installs into the ./.sandcastle SUBDIR, so
# copier's subproject subdir is ".sandcastle", but its update diff runs inside a
# temp render where the files sit at root — `git diff-tree ... .sandcastle` then
# dies "not in the working tree"; copier 9.17.1). A plain re-render sidesteps it,
# and it is SAFE here because adopters never hand-edit .sandcastle — the
# orchestrator is generated (CONTEXT.md). Any local edit under .sandcastle WOULD
# be clobbered; that is the known ceiling of this approach.
#
# REF defaults to the newest sandcastle-template/v* tag in the skills checkout.
set -euo pipefail

TEMPLATE_URL="https://github.com/caneff/agent-skills.git"
SKILLS_REPO="${SKILLS_REPO:-$HOME/.agents/skills}"
SEARCH_ROOT="${SEARCH_ROOT:-$HOME/src}"

PRETEND=""
if [ "${1:-}" = "--dry-run" ]; then PRETEND="--pretend"; shift; fi

REF="${1:-$(git -C "$SKILLS_REPO" tag -l 'sandcastle-template/v*' | sort -V | tail -1)}"
[ -n "$REF" ] || { echo "no sandcastle-template/v* tag in $SKILLS_REPO" >&2; exit 1; }
echo "Propagating $REF${PRETEND:+ (dry run)}"

updated=0 skipped=0
while IFS= read -r -d '' answers; do
  # Ours? Match the _src_path key, not any substring. Skip before any git work.
  grep -q '^_src_path:.*caneff/agent-skills' "$answers" || continue
  repo=$(git -C "$(dirname "$answers")" rev-parse --show-toplevel 2>/dev/null) || {
    echo "  skip $answers — not inside a git repo"; skipped=$((skipped + 1)); continue
  }
  name=$(basename "$repo")

  if [ -n "$(git -C "$repo" status --porcelain)" ]; then
    echo "  skip $name — working tree dirty; commit or stash first"
    skipped=$((skipped + 1)); continue
  fi

  pyv=$(sed -n "s/^PYTHON_VERSION: *//p" "$answers" | tr -d "\"'")
  echo "== $name (PYTHON_VERSION=$pyv) =="
  if ! ( cd "$repo" && copier copy --overwrite --defaults $PRETEND \
        --vcs-ref "$REF" --data PYTHON_VERSION="$pyv" \
        "$TEMPLATE_URL" ./.sandcastle ); then
    echo "  copier failed for $name — skipping" >&2
    skipped=$((skipped + 1)); continue
  fi

  [ -n "$PRETEND" ] && continue

  if [ -z "$(git -C "$repo" status --porcelain)" ]; then
    echo "  already at $REF, nothing to commit"; continue
  fi
  # Guard the whole commit+push: a stale branch or push reject skips this repo,
  # it does not abort the sweep to every repo after it.
  if ! ( git -C "$repo" add .sandcastle &&
         git -C "$repo" commit -q -m "chore(sandcastle): update template to $REF" &&
         git -C "$repo" push -q ); then
    echo "  commit/push failed for $name — skipping (repo left with local commit)" >&2
    skipped=$((skipped + 1)); continue
  fi
  echo "  committed + pushed"
  updated=$((updated + 1))
done < <(find "$SEARCH_ROOT" -maxdepth 4 -path '*/.sandcastle/.copier-answers.yml' -print0)

echo "Done. updated=$updated skipped=$skipped"
