#!/usr/bin/env bash
# sandcastle-propagate [--dry-run] [--divergence] [REF]
#
# Carry the Sandcastle template into every adopter repo with a real 3-way
# `copier update`, then open a pull request on each. Adopters are discovered, not listed:
# any repo under $SEARCH_ROOT with a root `.copier-answers.yml` breadcrumb
# pointing at caneff/agent-skills.
#
# Uses `copier update`, not the old `copier copy --overwrite` re-render hack.
# Update works now because the subproject root is the target's git root, with
# `.sandcastle/` a subtree beneath it (#93) — so copier's update diff resolves
# and it merges template edits while preserving an adopter's own edits (a
# conflict surfaces as markers to resolve, not a silent overwrite). The breadcrumb
# copier reads lives at the repo root, so update runs from there.
#
# REF defaults to the newest sandcastle-template/v* tag in the skills checkout.
#
# Every adopter lands in one of four classes — updated, current, skipped (a
# legitimate pass), failed (a fault) — and the run exits non-zero when anything
# failed, or when it matched no adopter at all. See
# references/updating-adopters.md.
#
# `--divergence` skips the update entirely and only reports how far each adopter
# has drifted from the template it recorded — see `divergence_report` below. A
# plain sweep prints that same report after each repo it updates.
set -euo pipefail

SKILLS_REPO="${SKILLS_REPO:-$HOME/.agents/skills}"
SEARCH_ROOT="${SEARCH_ROOT:-$HOME/src}"

PRETEND="" REPORT_ONLY=""
while [ -n "${1:-}" ] && [ "$1" != "${1#--}" ]; do
  case "$1" in
    --dry-run) PRETEND="--pretend" ;;
    --divergence) REPORT_ONLY=yes ;;
    *) echo "unknown flag $1" >&2; exit 1 ;;
  esac
  shift
done

# Once, before any repo is touched. Discovering an unusable `gh` after the first
# adopter is already committed would leave the fleet half-swept. `--dry-run`
# never reaches `gh`, so it stays usable unauthenticated.
if [ -z "$REPORT_ONLY" ] && [ -z "$PRETEND" ]; then
  command -v gh >/dev/null 2>&1 || { echo "no gh on PATH — install it, or use --dry-run" >&2; exit 1; }
  gh auth status >/dev/null 2>&1 || { echo "gh is not authenticated — run gh auth login" >&2; exit 1; }
fi

# One answer out of a breadcrumb, unquoted. Empty when the key isn't recorded.
breadcrumb() { sed -n "s/^$1: *//p" "$2" | tr -d "\"'"; }

# How far each adopter has drifted from the template it recorded. Rendered fresh
# every run, never maintained: `copier copy` at the repo's OWN `_commit` with the
# repo's OWN answers reconstructs what the template gave it, and the diff against
# the live tree is the divergence. Diffing against the newest tag instead would
# make a repo that simply hasn't synced yet look like one that had diverged.
#
# The report is a plain `git diff` of the re-render against the adopter's live
# subtree. A `sandcastle:local` marker comment shows up next to its own change,
# so its reason reaches a reviewer in the diff with nothing to parse.
divergence_report() {
  local repo=$1 name=$2 answers=$3 commit src ref work data
  commit=$(breadcrumb _commit "$answers")
  src=$(breadcrumb _src_path "$answers")
  [ -n "$commit" ] && [ -n "$src" ] || { echo "  no _commit in $name's breadcrumb — no divergence report" >&2; return 0; }

  ref=$(mktemp -d); work=$(mktemp -d); data=$(mktemp)
  trap 'rm -rf "$ref" "$work" "$data"' RETURN
  # copier's own bookkeeping keys are not answers; feeding them back is an error.
  # `|| true`: a breadcrumb of nothing but bookkeeping selects no lines, and a
  # grep that matched nothing exits 1 — which under `set -e` would end the sweep.
  grep -v '^_' "$answers" > "$data" || true
  if ! copier copy --defaults --trust --vcs-ref "$commit" --data-file "$data" "$src" "$ref" >/dev/null 2>&1; then
    echo "  could not re-render $name at $commit — no divergence report" >&2
    return 0
  fi

  # Diff against a COPY of the adopter's subtree with its runtime exhaust pruned —
  # logs, `.env`, scratch JSON. `ls-files --others --ignored` is git's own answer
  # to "what does this repo ignore", honoring the root file, the `.sandcastle/`
  # subtree and the user's global one; `--others` leaves tracked files in, so a
  # rendered file that happens to match a pattern still reports. The temp render
  # needs no such filter — built from the manifest, it holds no exhaust.
  cp -a "$repo/.sandcastle" "$work/.sandcastle"
  git -C "$repo" ls-files -z --others --ignored --exclude-standard -- .sandcastle |
    while IFS= read -r -d '' f; do rm -rf "$work/$f"; done

  # `|| true`: git diff exits 1 on a difference — the normal case here, which
  # `set -e -o pipefail` would otherwise read as a fault. The sed strips the temp
  # roots so both sides read `.sandcastle/…`, not the `/tmp/xxxx/` paths.
  { git diff --no-index --no-prefix -- "$ref/.sandcastle" "$work/.sandcastle" 2>/dev/null || true; } |
    sed "s#$ref/##g; s#$work/##g"
}

# A report-only run carries nothing, so it needs no ref — and must not die on a
# checkout that has no template tag at all.
if [ -n "$REPORT_ONLY" ]; then
  REF=""
  echo "Reporting divergence"
else
  REF="${1:-$(git -C "$SKILLS_REPO" tag -l 'sandcastle-template/v*' | sort -V | tail -1)}"
  [ -n "$REF" ] || { echo "no sandcastle-template/v* tag in $SKILLS_REPO" >&2; exit 1; }
  # Named for the ref, not the clock: a re-run at the same ref reuses the branch,
  # where a timestamped name would litter every adopter with dead branches.
  BRANCH="sandcastle/update-to-$(printf %s "$REF" | tr -c 'A-Za-z0-9._-' '-')"
  TITLE="chore(sandcastle): update template to $REF"
  echo "Propagating $REF${PRETEND:+ (dry run)}"
fi

# Four classes, because two could not tell "every repo is already current" from
# "I reached none of them" — both printed `updated=0 skipped=0`. `inspected`
# belongs to the two modes that carry nothing, which may not leave a repo
# uncounted either.
updated=0 current=0 skipped=0 failed=0 inspected=0
# Every breadcrumb the walk saw, and the subset naming this template. A sweep
# that matched nothing is an error, and these two tell apart a search root
# pointed at the wrong tree from a filter that excluded the whole fleet.
crumbs=0 mine=0
while IFS= read -r -d '' answers; do
  crumbs=$((crumbs + 1))
  # Ours? Match the _src_path key, not any substring. Skip before any git work.
  grep -q '^_src_path:.*caneff/agent-skills' "$answers" || continue
  # The breadcrumb sits at the repo root, so its dir is the repo (up to symlinks).
  repo=$(git -C "$(dirname "$answers")" rev-parse --show-toplevel 2>/dev/null) || {
    mine=$((mine + 1))
    echo "  $answers — not inside a git repo" >&2; failed=$((failed + 1)); continue
  }
  # A linked worktree carries a checked-out copy of the repo's own breadcrumb, and
  # `--show-toplevel` inside one answers with the worktree, so it reads as a repo
  # of its own — a sweep would push a branch and open a PR out of someone's
  # in-progress work (#194). The two git dirs differ in a linked worktree and
  # nowhere else, so this catches one at any depth and under any layout. Counted
  # before `mine`, so passing over one never stands in for reaching an adopter: a
  # search root narrowed onto worktrees alone has matched nobody, and says so.
  [ "$(git -C "$repo" rev-parse --git-dir)" = "$(git -C "$repo" rev-parse --git-common-dir)" ] || continue
  mine=$((mine + 1))
  name=$(basename "$repo")

  lang=$(breadcrumb LANGUAGE "$answers")
  echo "== $name (LANGUAGE=$lang) =="

  # Report-only: render, diff, print. Nothing is updated, committed or pushed,
  # so a dirty tree is no obstacle — it is just more divergence to report.
  if [ -n "$REPORT_ONLY" ]; then
    divergence_report "$repo" "$name" "$answers"
    inspected=$((inspected + 1)); continue
  fi

  if [ -n "$(git -C "$repo" status --porcelain)" ]; then
    echo "  skip $name — working tree dirty; commit or stash first"
    skipped=$((skipped + 1)); continue
  fi
  # Stacking an update on an unreviewed one is the diamond-base failure #127
  # tracks: the second PR's diff is read against a base nobody has accepted yet.
  if [ -z "$PRETEND" ]; then
    # A `gh` that could not answer is not an answer of "none open" — reading a
    # rate limit as an empty list is how the stacked PR gets opened anyway.
    if ! open_pr=$( cd "$repo" && gh pr list --state open --json url,headRefName \
        --jq 'map(select(.headRefName | startswith("sandcastle/update-to-")))[0].url // empty' ); then
      echo "  could not list $name's open PRs" >&2
      failed=$((failed + 1)); continue
    fi
    if [ -n "$open_pr" ]; then
      echo "  skip $name — sweep PR already open: $open_pr"
      skipped=$((skipped + 1)); continue
    fi
  fi
  # Captured before copier writes anything: the ref this repo is moving FROM,
  # for the PR body, and the commit the local checkout is restored to after.
  from=$(breadcrumb _commit "$answers")
  base=$(git -C "$repo" rev-parse HEAD)
  # `copier update` reads the template URL, the old ref, AND every recorded
  # answer from the breadcrumb, re-asserting them itself — so we steer the
  # target ref and nothing else. Feeding an answer back in is worse than
  # redundant now that PYTHON_VERSION is conditional: on a node adopter the
  # lookup comes back empty and injects a question the template stopped asking.
  if ! ( cd "$repo" && copier update --defaults --trust $PRETEND \
        --vcs-ref "$REF" ); then
    echo "  copier failed for $name" >&2
    failed=$((failed + 1)); continue
  fi

  # A pretend run wrote nothing, so there is no outcome to classify — only the
  # fact that this repo was reached, which is the whole point of the flag.
  if [ -n "$PRETEND" ]; then
    inspected=$((inspected + 1)); continue
  fi

  if [ -z "$(git -C "$repo" status --porcelain)" ]; then
    echo "  already at $REF, nothing to commit"
    divergence_report "$repo" "$name" "$answers"
    current=$((current + 1)); continue
  fi
  # A real conflict (an adopter edited a file the template also changed) lands as
  # inline `<<<<<<<`/`>>>>>>>` markers — copier's default. Never commit those:
  # surface them for a human, don't push a half-merged tree.
  if grep -rIlE '^(<{7}|>{7}) ' "$repo/.sandcastle" >/dev/null 2>&1; then
    echo "  update left inline conflict markers in $name — resolve by hand" >&2
    failed=$((failed + 1)); continue
  fi
  # Commit on the branch that is already checked out and push it under another
  # name by refspec — the local checkout never switches. Guard the whole thing:
  # a push reject skips this repo, it does not abort the sweep to the repos
  # after it.
  pushed=""
  report=""
  if ( git -C "$repo" add .sandcastle .copier-answers.yml &&
       git -C "$repo" commit -q -m "$TITLE" ); then
    # Same report as `--divergence`, now that the breadcrumb records the new ref:
    # what the merge could not carry is exactly what this repo holds locally.
    report=$(divergence_report "$repo" "$name" "$answers")
    # Forced, because the branch is named for the ref and the sweep owns that
    # namespace: a second run at the same ref regenerates the same update, and a
    # branch an earlier run left behind would otherwise reject it forever. The
    # skip above means no branch with a PR open for review is ever overwritten.
    git -C "$repo" push -q --force origin "HEAD:refs/heads/$BRANCH" && pushed=yes
  fi
  # Unconditional, so a failed push leaves the repo byte-identical to how the
  # sweep found it. The commit object survives the reset; the pushed branch owns
  # it now.
  git -C "$repo" reset -q --hard "$base"
  [ -n "$report" ] && printf '%s\n' "$report"
  if [ -z "$pushed" ]; then
    echo "  commit/push failed for $name" >&2
    failed=$((failed + 1)); continue
  fi
  # The report a human is here to read, under the two refs it moved between.
  body=$(printf 'Sandcastle template: %s → %s\n\nDivergence after the update:\n\n%s\n' \
    "${from:-unknown}" "$REF" "${report:-none}")
  if ! url=$( cd "$repo" && gh pr create --head "$BRANCH" --title "$TITLE" --body "$body" ); then
    echo "  gh pr create failed for $name — branch $BRANCH is pushed, open it by hand" >&2
    failed=$((failed + 1)); continue
  fi
  echo "  $url"
  updated=$((updated + 1))
done < <(find "$SEARCH_ROOT" -maxdepth 4 -name '.copier-answers.yml' -print0)

if [ "$mine" -eq 0 ]; then
  if [ "$crumbs" -eq 0 ]; then
    echo "no .copier-answers.yml anywhere under $SEARCH_ROOT — wrong search root?" >&2
  else
    echo "found $crumbs .copier-answers.yml under $SEARCH_ROOT, none of them an adopter of caneff/agent-skills" >&2
  fi
  exit 1
fi

if [ -n "$REPORT_ONLY" ] || [ -n "$PRETEND" ]; then
  echo "Done. inspected=$inspected skipped=$skipped failed=$failed"
else
  echo "Done. updated=$updated current=$current skipped=$skipped failed=$failed"
fi

# Only a fault, and only from a run that was carrying something: exiting
# non-zero on a dirty tree would teach the reader to ignore the status, and
# `--divergence` changes nothing, so nothing it meets is worth blocking on. It
# still counts the fault above.
[ -n "$REPORT_ONLY" ] || [ "$failed" -eq 0 ] || exit 1
