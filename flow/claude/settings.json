{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "claude-opus-4-8[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Opus 4.8 (1M)",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Opus 4.8 with 1M context window",
    "CLAUDE_PTY_ORPHAN_CHECK_MS": "20000",
    "CLAUDE_PTY_HEARTBEAT_MS": "180000",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false"
  },
  "permissions": {
    "allow": [
      "Bash(gh auth *)",
      "Bash(gh issue *)",
      "Bash(gh issue edit:*)",
      "Bash(gh label *)",
      "Bash(git -C:*)",
      "Bash(git branch -d *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git worktree *)",
      "Bash(git worktree:*)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(cargo build)",
      "Bash(cargo build *)",
      "Bash(cargo check)",
      "Bash(cargo check *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(node *)",
      "Bash(pushpr)",
      "Bash(pushpr:*)",
      "Bash(python3 -)",
      "EnterWorktree",
      "ExitWorktree",
      "Read(//home/caneff/.claude/**)",
      "Read(//home/caneff/.codex/**)",
      "Read(//home/caneff/.codex/skills/**)",
      "Read(//tmp/**)",
      "mcp__exa__web_search_exa",
      "mcp__c4ai__md",
      "mcp__c4ai__execute_js",
      "mcp__c4ai__screenshot"
    ],
    "deny": [
      "AskUserQuestion",
      "NotebookEdit",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "mcp__c4ai__crawl",
      "mcp__c4ai__html",
      "mcp__c4ai__pdf",
      "mcp__c4ai__ask"
    ],
    "defaultMode": "auto",
    "autoMode": {
      "allow": [
        "$defaults",
        "Git worktree commands in any repository, including the `git -C <path> worktree ...` form: add, list, lock, unlock, prune, remove.",
        "Driving the OBS e2e rig from this repo: closing OBS's window via PowerShell `Get-Process obs64` + `CloseMainWindow()`, and any obs-websocket request sent through `layout/obs-request.mjs` (including SetSourceFilterEnabled).",
        "Editing, commenting on, closing, and labelling GitHub issues in the user's own repos with `gh issue edit|comment|close|create`, including inside a compound command that first prepares the body in the scratchpad.",
        "Publishing, republishing, or updating an Artifact with the Artifact tool (the default publish action, with or without a url), whenever the user has asked for a page, report, or reference to be built or updated, or has already been shown one earlier in the session. The user has given blanket permission for artifact publishes."
      ]
    }
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "design": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "keybindings-help": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "init": "off",
    "add-molab-badge": "off",
    "anywidget-generator": "off",
    "auto-paper-demo": "off",
    "find-skills": "off",
    "implement-paper-auto": "off",
    "loop-me": "off",
    "marimo-batch": "off",
    "marimo-notebook": "off",
    "marimo-pair": "off",
    "orchestration": "off",
    "setup-ts-deep-modules": "off",
    "streamlit-to-marimo": "off",
    "to-questionnaire": "off",
    "uv": "off",
    "wasm-compatibility": "off",
    "wizard": "off",
    "writing-beats": "off",
    "writing-fragments": "off",
    "writing-shape": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/require-agent-model.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/wrap-background-jobs.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/refresh-landed.sh",
            "statusMessage": "Refreshing landed page"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/caneff/.agents/skills/skills-sync/skills-sync.sh --fix >/dev/null 2>&1 || true",
            "statusMessage": "Syncing skill symlinks"
          },
          {
            "type": "command",
            "command": "bash /home/caneff/.agents/skills/flow/backup-sync.sh --commit >/dev/null 2>&1 || true",
            "statusMessage": "Backing up VS Code settings"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/caneff/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/worker-stop-alert.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{time:(now|todate), cwd, session_id, tool:.tool_name, input:.tool_input}' >> ~/.claude/permission-prompts.jsonl 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/caneff/src/fleet-rail/hooks/record.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "worktree"
  },
  "disableAgentView": true,
  "disableRemoteControl": true,
  "disableWorkflows": false,
  "bashEditDiffEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "python3 /home/caneff/.agents/skills/flow/ccstatusline-table/table-statusline.py",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "outputStyle": "Quill",
  "feedbackDrafts": "off",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "model": "claude-fable-5-1[1m]"
}
