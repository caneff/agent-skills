{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "claude-opus-4-8[1m]",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Opus 4.8 (1M)",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Opus 4.8 with 1M context window"
  },
  "permissions": {
    "allow": [
      "Bash(gh auth *)",
      "Bash(gh issue *)",
      "Bash(gh issue edit:*)",
      "Bash(gh label *)",
      "Bash(git branch -d *)",
      "Bash(git diff *)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git worktree *)",
      "Bash(land)",
      "Bash(node *)",
      "Bash(pushpr)",
      "Bash(pushpr:*)",
      "Bash(python3 -)",
      "Read(//home/caneff/.claude/**)",
      "Read(//home/caneff/.codex/**)",
      "Read(//home/caneff/.codex/skills/**)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "AskUserQuestion",
      "NotebookEdit",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "dataviz": "off",
    "design": "off",
    "artifact-capabilities": "off",
    "artifact-diagramming": "off",
    "schedule": "off",
    "run": "off",
    "loop": "off",
    "keybindings-help": "off",
    "simplify": "off",
    "fewer-permission-prompts": "off",
    "init": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/require-worktree.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.agents/skills/flow/claude/hooks/require-agent-model.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/block-dangerous-git.sh"
          },
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/caneff/.claude/hooks/sync-primary-main.sh",
            "statusMessage": "Syncing primary worktree main"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/caneff/.agents/skills/skills-sync/skills-sync.sh --fix >/dev/null 2>&1 || true",
            "statusMessage": "Syncing skill symlinks"
          },
          {
            "type": "command",
            "command": "bash /home/caneff/.agents/skills/flow/backup-sync.sh --commit >/dev/null 2>&1 || true",
            "statusMessage": "Backing up VS Code settings"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "worktree"
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "python3 /home/caneff/.agents/skills/ccstatusline-table/table-statusline.py",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "chopratejas/headroom"
      }
    }
  },
  "outputStyle": "Orwell STE",
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "model": "opus[1m]"
}
