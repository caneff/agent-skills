#!/usr/bin/env bash
# Link the herdr toast scripts from this directory into ~/.local/bin and point
# the herdrfocus: URL handler at the real file. Windows cannot follow a WSL
# symlink over \\wsl.localhost, so everything Windows reads is addressed by
# its flow/bin path, never by the ~/.local/bin link. Safe to re-run.
#
# Refuses from a linked worktree or a path under /tmp: both are disposable, and
# the links and the registry value would outlive them (2026-09-21: a review
# mutation run from /tmp left the real handler pointing at a deleted path).
# HERDR_TOAST_ALLOW_TMP=1 lifts the /tmp refusal only, for the fixture test.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
dest="$HOME/.local/bin"
names="notify-send run-hidden.vbs herdr-focus.vbs herdr-focus-pick.ps1 herdr-focus-latest"

case "$here" in /tmp/*)
  [ "${HERDR_TOAST_ALLOW_TMP:-}" = 1 ] || { echo "refusing: $here is under /tmp" >&2; exit 1; };;
esac
if gitdir=$(git -C "$here" rev-parse --path-format=absolute --git-dir 2>/dev/null); then
  common=$(git -C "$here" rev-parse --path-format=absolute --git-common-dir)
  [ "$gitdir" = "$common" ] || { echo "refusing: $here is in a linked worktree; run from the primary checkout" >&2; exit 1; }
fi

mkdir -p "$dest"
for n in $names; do
  [ -d "$dest/$n" ] && [ ! -L "$dest/$n" ] && { echo "refusing: $dest/$n is a real directory" >&2; exit 1; }
done

# Registry first: flow/bin's files exist whether or not the links do, so a
# failure here leaves ~/.local/bin exactly as it was and the old handler still
# working. wslpath gives the same \\wsl.localhost\<distro>\... form the shim uses.
# reg.exe is called directly (not through powershell.exe) so the \" escapes
# reach it as the literal quotes a path with a space needs.
unc=$(wslpath -w "$here")
reg.exe add 'HKCU\Software\Classes\herdrfocus\shell\open\command' /ve \
  /d "wscript.exe //B //Nologo \"${unc}\herdr-focus.vbs\" \"%1\"" /f >/dev/null

for n in $names; do
  if [ -e "$dest/$n" ] && [ ! -L "$dest/$n" ]; then
    mv "$dest/$n" "$dest/$n.pre-flow"
    echo "backed up existing $dest/$n -> $dest/$n.pre-flow"
  fi
  ln -sfn "$here/$n" "$dest/$n"
done
