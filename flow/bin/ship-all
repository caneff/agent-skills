#!/usr/bin/env bash
# ship-all [--dry-run] [--except N,N,...] — ship every ready PR, one at a time, via `ship`.
# Re-reads the ready list before each merge so main stays current between ships.
# A PR that fails (conflict, red checks) is skipped, not fatal — reported at the end.
# --dry-run: print the ready PRs in ship order and exit, merging nothing.
# --except:  comma-separated PR numbers to leave alone.
set -uo pipefail

dry=""
except=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    --except)  except="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

ready_numbers() {
  # ready = open, not draft, not conflicting, not in --except. Oldest first.
  gh pr list --state open --json number,title,isDraft,mergeable \
    -q '.[] | select(.isDraft | not) | select(.mergeable != "CONFLICTING") | "\(.number)\t\(.title)"' \
    | { [ -n "$except" ] && grep -vE "^(${except//,/|})	" || cat; }
}

if [ -n "$dry" ]; then
  echo "would ship, in order:"
  ready_numbers | sed 's/^/  #/'
  exit 0
fi

failed=()
while true; do
  mapfile -t ready < <(ready_numbers | cut -f1 \
    | grep -vFx -f <(printf '%s\n' "${failed[@]}") 2>/dev/null || true)
  [ "${#ready[@]}" -eq 0 ] && break

  pr="${ready[0]}"
  echo "=== ship #$pr (${#ready[@]} ready) ==="
  if ! ship "$pr"; then
    echo "!! #$pr failed — skipping" >&2
    failed+=("$pr")
  fi
done

if [ "${#failed[@]}" -gt 0 ]; then
  echo "skipped: ${failed[*]}" >&2
  exit 1
fi
echo "all ready PRs shipped"
