#!/usr/bin/env bash
# issue-counts — open-issue counts for the current repo (gh infers repo from cwd):
# the standard wayfinder frontier groups, then any other repo labels with open
# issues (most first).
#
#   issue-counts            pretty two-section report
#   issue-counts --status   one compact line, nonzero groups only (for a status line)
#
# One gh call pulls every open issue with its labels + blockedBy; all counts are
# tallied locally with jq. Ready-now uses the real blockedBy field (truer than
# the `no:blocked-by` search qualifier, which lags GitHub's dependency index).

data=$(gh issue list --state open --limit 500 --json labels,blockedBy 2>/dev/null)
[ -z "$data" ] && data='[]'

# "count<TAB>emoji<TAB>label" in fixed frontier order
wf=$(printf '%s' "$data" | jq -r '
  [ .[] | { l: [.labels[].name], b: (.blockedBy|length) } ] as $iss
  | def cnt(f): ([ $iss[] | select(f) ] | length);
    "\(cnt((.l|any(.=="ready-for-agent")) and .b==0))\t✅\tReady now",
    "\(cnt(.l|any(.=="wayfinder:grilling")))\t🔥\tGrilling",
    "\(cnt(.l|any(.=="wayfinder:map")))\t🗺\tMaps",
    "\(cnt(.l|any(.=="in-progress" or .=="in-review" or .=="needs-review")))\t🚧\tIn flight",
    "\(cnt(.l|any(.=="spec")))\t📋\tSpecs",
    "\(cnt(.l|any(.=="backlog")))\t💤\tBacklog"
')

# "count<TAB>label" for every non-frontier label with open issues, most first
others=$(printf '%s' "$data" | jq -r '
  ["ready-for-agent","wayfinder:grilling","wayfinder:map","in-progress","in-review","needs-review","spec","backlog"] as $wf
  | [ .[].labels[].name | select(. as $x | $wf | any(. == $x) | not) ]
  | group_by(.) | map("\(length)\t\(.[0])") | .[]
' | sort -rn)

if [ "${1:-}" = "--status" ]; then
  line=$(printf '%s\n' "$wf"     | awk -F'\t' '{printf "%s%s ",$2,$1}')
  o=$(printf '%s\n' "$others"    | awk -F'\t' 'NF{printf "%s%s ",$2,$1}')
  line="${line% }"; o="${o% }"
  [ -n "$o" ] && line="${line}${line:+ · }$o"
  printf '%s\n' "$line"
else
  echo "── wayfinder ──"
  printf '%s\n' "$wf" | while IFS=$'\t' read -r n emoji label; do printf "%4s  %s %s\n" "$n" "$emoji" "$label"; done
  if [ -n "$others" ]; then
    echo "── other ──"
    printf '%s\n' "$others" | while IFS=$'\t' read -r n label; do printf "%4s  %s\n" "$n" "$label"; done
  fi
fi
