#!/usr/bin/env node
// Drive a local file or a URL headlessly and print what the page says, as
// JSON. The companion to page-shot for the cases a picture cannot answer.
//
//   page-eval <file-or-url> [--click SEL]... [--fill SEL=VALUE]... [--wait ms]
//             [--js EXPR]... [--text SEL]... [--shot out.png]
//
// --js takes an expression, not statements: wrap statements in an IIFE. Every
// flag is repeatable and they run fills, then clicks, then reads. A selector
// or expression that throws lands in the JSON as "ERR: ..." rather than
// killing the run, so one bad probe does not cost the others.
import { resolve } from 'node:path'
import { arg, openPage } from './browser.mjs'

const argv = process.argv.slice(2)
const { all, one } = arg(argv)
const usage = 'usage: page-eval <file-or-url> [--click SEL] [--fill SEL=VAL] [--js EXPR] [--text SEL] [--shot out.png] [--wait ms]'

const target = argv[0]
if (!target || target.startsWith('--')) {
  console.error(usage)
  process.exit(2)
}

const { browser, page, errors } = await openPage(target)
const out = {}

for (const pair of all('--fill')) {
  const [selector, ...value] = pair.split('=')
  await page.fill(selector, value.join('='))
}
for (const selector of all('--click')) await page.click(selector)
await page.waitForTimeout(+one('--wait', 250))
for (const selector of all('--text')) {
  out[selector] = await page.textContent(selector).catch(e => `ERR: ${e.message}`)
}
for (const expr of all('--js')) {
  out[expr] = await page.evaluate(expr).catch(e => `ERR: ${e.message}`)
}
const shot = one('--shot')
if (shot) {
  await page.screenshot({ path: resolve(shot), fullPage: true })
  out.shot = resolve(shot)
}
if (errors.length) out.pageErrors = errors

await browser.close()
console.log(JSON.stringify(out, null, 2))
