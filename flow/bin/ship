#!/usr/bin/env bash
# ship [pr-number] [--squash|--rebase|--merge] — merge a PR, wait for it to land,
# then sync local main.
#
# Without a pr-number: finds open PRs that are ready to ship (not draft, not
# conflicting). Exactly one -> ships it; several -> asks which (needs a tty).
#
# Strategy defaults by churn, not author: what dirties history is commits pushed AFTER
# the PR opens (review fixups, "address comments", wip), not who wrote it. Measure it —
# any post-creation commit => squash to one clean commit; none (the PR landed as its
# original atomic commits) => rebase-merge so that history survives on main. Pass an
# explicit flag to override.
set -euo pipefail

# Run from the main checkout, whatever directory this was invoked from. Called
# inside a linked worktree, the worktree-removal guard below compares the
# worktree against itself, skips, and `gh pr merge --delete-branch` then dies on
# "'main' is already used by worktree" — after the merge, before main is synced.
# The main worktree is always the first entry.
cd "$(git worktree list --porcelain | awk 'NR==1{print $2}')"

pr="${1:-}"
strategy="${2:-}"

if [[ "$pr" == --* ]]; then strategy="$pr"; pr=""; fi

if [ -z "$pr" ]; then
  mapfile -t candidates < <(gh pr list --state open --json number,title,isDraft,mergeable \
    -q '.[] | select(.isDraft | not) | select(.mergeable != "CONFLICTING") | "\(.number)\t\(.title)"')
  case "${#candidates[@]}" in
    0) echo "no open PR is ready to ship" >&2; exit 1 ;;
    1) pr="${candidates[0]%%$'\t'*}"
       echo "shipping the only ready PR: #$pr (${candidates[0]#*$'\t'})" ;;
    *) printf '#%s\n' "${candidates[@]/$'\t'/  }" >&2
       if [ ! -t 0 ]; then
         echo "several ready PRs — rerun with a number: ship <n>" >&2
         exit 1
       fi
       read -r -p "which PR number? " pr
       [[ "$pr" =~ ^[0-9]+$ ]] || { echo "aborted" >&2; exit 1; } ;;
  esac
fi

if [ -z "$strategy" ]; then
  created="$(gh pr view "$pr" --json createdAt -q .createdAt)"
  churn="$(gh pr view "$pr" --json commits -q \
    "[.commits[] | select(.committedDate > \"$created\")] | length")"
  if [ "${churn:-0}" -gt 0 ]; then
    strategy=--squash
  else
    strategy=--rebase
  fi
fi

# If the PR's branch is checked out in a linked worktree (e.g. /implement cut
# one), remove that worktree first. Otherwise `--delete-branch`'s LOCAL delete
# fails with "cannot delete branch used by worktree", and under `set -e` that
# aborts ship after the merge but BEFORE main is synced. Removing the worktree
# frees the branch so gh cleans up both remote and local. `remove` (not
# --force) refuses if the worktree is dirty — surfaces uncommitted work instead
# of nuking it.
head="$(gh pr view "$pr" --json headRefName -q .headRefName)"

# Confirm the PR will actually merge BEFORE touching its worktree. The
# worktree removal below is irreversible-ish (it's often a /implement worktree
# with deps installed), so a conflicting PR that loses it costs a full rebuild
# just to resolve. The no-number candidate picker filters CONFLICTING, but the
# explicit-PR path (ship <branch>) skips that — guard it here. gh reports
# UNKNOWN until GitHub finishes computing mergeability, so poll briefly.
mergeable="$(gh pr view "$pr" --json mergeable -q .mergeable)"
for _ in 1 2 3 4 5; do
  [ "$mergeable" != UNKNOWN ] && break
  sleep 2
  mergeable="$(gh pr view "$pr" --json mergeable -q .mergeable)"
done

wt="$(git worktree list --porcelain \
  | awk -v b="refs/heads/$head" '/^worktree /{p=$2} /^branch /{if ($2==b) print p}')"
if [ "$mergeable" = CONFLICTING ]; then
  # Rebase, never merge main in: ship rebase-merges a PR with no post-creation
  # commits (see strategy above), and a merge commit in the branch is what
  # makes that replay messy.
  echo "ship: PR #$pr conflicts with its base — not merging, worktree left in place." >&2
  echo "  resolve in the branch's worktree, then re-run ship:" >&2
  echo "    cd ${wt:-<worktree-for-$head>} && git fetch origin main && git rebase origin/main && git push --force-with-lease" >&2
  exit 1
fi

if [ -n "$wt" ] && [ "$wt" != "$(git rev-parse --show-toplevel)" ]; then
  echo "ship: removing worktree $wt (branch $head about to merge)"
  git worktree remove "$wt"
fi

gh pr merge "$pr" "$strategy" --delete-branch
until [ "$(gh pr view "$pr" --json state -q .state)" = MERGED ]; do sleep 10; done
~/.claude/hooks/sync-main-after-merge.sh --now
