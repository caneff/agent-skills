#!/usr/bin/env python3
"""automode-entry -- change autoMode entries in ~/.claude/settings.json in place.

  automode-entry add <section> <text|-|@file>   append one entry
  automode-entry open                           write the whole autoMode block to a document
  automode-entry apply                          diff the edited document, write, commit, push

Sections: allow, soft_deny, environment. `-` reads the text from stdin (a
heredoc), `@file` from a file; a `!` command is not known to get interactive
stdin, so there is no prompt.

`open` writes one `# <section>` heading per section and one entry per
paragraph to <primary checkout>/.scratch/automode.md: outside
`.claude/worktrees`, where Zed hides the tree and never reloads a tab. Edit it,
then `apply` prints each added (`+`) and removed (`-`) entry, writes the
settings, reads each changed rule back through `claude auto-mode config`, and
commits and pushes. `apply` refuses an unknown or repeated heading, a missing
one, text before the first heading, and settings that changed since `open`.
Both `add` and `apply` refuse to start while the settings file has uncommitted
changes, so the commit holds only the autoMode edit.

The write goes through open(path, "w"), which follows the symlink, so
~/.claude/settings.json stays a symlink; a tmp file renamed over it would not.
The serialized text is parsed back and encoded before the file is opened, so
a refusal leaves it unchanged. When the read-back or the commit fails after the
write, the file keeps the change uncommitted and the dirty-file refusal stops
the next run until it is resolved by hand.
"""

import difflib
import json
import os
import subprocess
import sys
import textwrap
from pathlib import Path

SECTIONS = ("allow", "soft_deny", "environment")
LABEL_SCAN = 120  # a colon inside an entry's first LABEL_SCAN chars ends its short label
LINK = Path.home() / ".claude" / "settings.json"


def die(msg):
    print(f"refused: {msg}  (file unchanged)", file=sys.stderr)
    sys.exit(1)


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)


def locate():
    """The settings file the link points at, its repo, and that repo's primary checkout."""
    target = LINK.resolve()
    top = git(target.parent, "rev-parse", "--show-toplevel")
    if top.returncode:
        die(f"{target} is not inside a git repo")
    common = git(target.parent, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common.returncode or not common.stdout.strip():
        die(f"cannot find the primary checkout of {target}: {common.stderr.strip()}")
    return target, Path(top.stdout.strip()), Path(common.stdout.strip()).parent


def require_clean(repo, target):
    """The commit is pathspec-limited to the settings file, so edits already in it would ride along."""
    st = git(repo, "status", "--porcelain", "--", str(target))
    if st.returncode:
        die(f"git status failed: {st.stderr.strip()}")
    if st.stdout.strip():
        die(f"{target} has uncommitted changes; commit or revert them first")


def load():
    try:
        text = LINK.read_text()
    except OSError as e:
        die(f"cannot read {LINK}: {e}")
    try:
        return json.loads(text)
    except json.JSONDecodeError as e:
        die(f"{LINK} does not parse: {e}")


def write(settings):
    text = json.dumps(settings, indent=2, ensure_ascii=False) + "\n"
    try:
        json.loads(text)
        data = text.encode("utf-8")  # strict: fails here, before the file is opened
    except (ValueError, UnicodeEncodeError) as e:
        die(f"the result would not be valid JSON text: {e}")
    with open(LINK, "wb") as f:  # follows the symlink
        f.write(data)


def norm(text):
    return " ".join(text.split())


def text_arg(arg):
    if arg == "-":
        raw = sys.stdin.buffer.read()
    elif arg.startswith("@"):
        try:
            raw = Path(arg[1:]).read_bytes()
        except OSError as e:
            die(f"cannot read {arg[1:]}: {e}")
    else:
        raw = os.fsencode(arg)
    try:
        text = norm(raw.decode("utf-8"))
    except UnicodeDecodeError as e:
        die(f"entry text is not UTF-8: {e}")
    if not text:
        die("empty entry text")
    return text


def section_of(settings, name):
    if name not in SECTIONS:
        die(f"section must be one of {', '.join(SECTIONS)}")
    return settings.setdefault("autoMode", {}).setdefault(name, ["$defaults"])


def short(entry, width=72):
    return textwrap.shorten(entry.split(":")[0] if ":" in entry[:LABEL_SCAN] else entry, width)


def show_and_commit(repo, target, final, added, removed, message):
    """Read the written rules back through `claude auto-mode config`; commit and push if every section agrees.

    `final` is the autoMode block as written. `added` and `removed` are {section: [entry]}.
    Each changed entry is checked in its own section, and every entry still in a section must
    show up there too: a config that never read the file prints none of them.
    """
    try:
        cfg = subprocess.run(
            ["claude", "auto-mode", "config"], capture_output=True, text=True, check=True
        ).stdout
        effective = json.loads(cfg)
        if not all(isinstance(effective.get(sec), list) for sec in SECTIONS):
            raise ValueError("output lacks a list for each of allow, soft_deny, environment")
    except (OSError, subprocess.CalledProcessError, ValueError) as e:
        print(f"settings written, not committed: `claude auto-mode config` failed: {e}", file=sys.stderr)
        sys.exit(1)
    bad = False
    for sec in SECTIONS:
        have = set(effective[sec])
        for e in added.get(sec, []):
            ok = e in have
            bad |= not ok
            print(f"  {'in' if ok else 'MISSING from'} claude auto-mode config ({sec}): {textwrap.shorten(e, 100)}")
        for e in removed.get(sec, []):
            ok = e not in have
            bad |= not ok
            print(f"  {'gone from' if ok else 'STILL in'} claude auto-mode config ({sec}): {textwrap.shorten(e, 100)}")
        missing = [e for e in final.get(sec, []) if e != "$defaults" and e not in have]
        for e in missing:
            print(f"  MISSING from claude auto-mode config ({sec}): {textwrap.shorten(e, 100)}")
        bad |= bool(missing)
    if bad:
        print("settings written, not committed: the rules do not match `claude auto-mode config`", file=sys.stderr)
        sys.exit(1)
    for step in (
        ["commit", "-q", "-m", f"autoMode: {message}", "--", str(target)],
        ["push", "-q"],
    ):
        r = git(repo, *step)
        if r.returncode:
            print(f"settings written, `git {step[0]}` failed: {r.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
    print(f"committed and pushed: autoMode: {message}")


def cmd_add(args):
    if len(args) != 2:
        die("usage: automode-entry add <section> <text|-|@file>")
    target, repo, _ = locate()
    require_clean(repo, target)
    settings = load()
    entries = section_of(settings, args[0])
    new = text_arg(args[1])
    if new in entries:
        die(f"{args[0]} already holds that entry")
    entries.append(new)
    write(settings)
    show_and_commit(repo, target, settings["autoMode"], {args[0]: [new]}, {}, f"add {args[0]} entry '{short(new, 40)}'")


def doc_paths(primary):
    d = primary / ".scratch"
    return d / "automode.md", d / "automode.base.json"


def cmd_open(args):
    if args:
        die("usage: automode-entry open")
    _, _, primary = locate()
    doc, base = doc_paths(primary)
    auto = load().get("autoMode", {})
    parts = ["<!-- automode-entry: one entry per paragraph; edit, add or delete, then `automode-entry apply` -->"]
    for sec in SECTIONS:
        parts.append(f"# {sec}")
        parts += auto.get(sec, [])
    doc.parent.mkdir(parents=True, exist_ok=True)
    doc.write_text("\n\n".join(parts) + "\n")
    base.write_text(json.dumps(auto, sort_keys=True))
    print(f"edit this file, then run `automode-entry apply`:\n{doc}")
    win = subprocess.run(["wslpath", "-w", str(doc)], capture_output=True, text=True)
    if win.returncode == 0:
        print(f"Windows path: {win.stdout.strip()}")


def parse(text):
    out, cur = {}, None
    for para in text.split("\n\n"):
        para = norm(para)
        if not para or para.startswith("<!--"):
            continue
        if para.startswith("# "):
            cur = para[2:].strip()
            if cur not in SECTIONS:
                die(f"unknown section heading '# {cur}'")
            if cur in out:
                die(f"section heading '# {cur}' appears twice")
            out[cur] = []
        elif cur is None:
            die("text before the first '# section' heading")
        else:
            out[cur].append(para)
    for sec in SECTIONS:
        if sec not in out:
            die(f"the document is missing the heading '# {sec}'")
    return out


def cmd_apply(args):
    if args:
        die("usage: automode-entry apply")
    target, repo, primary = locate()
    doc, base = doc_paths(primary)
    if not doc.exists() or not base.exists():
        die("run `automode-entry open` first")
    require_clean(repo, target)
    settings = load()
    if json.dumps(settings.get("autoMode", {}), sort_keys=True) != base.read_text():
        die("autoMode changed since open; run `automode-entry open` again")
    new = parse(doc.read_text())
    added, removed, changed = {}, {}, False
    for sec in SECTIONS:
        before = settings.get("autoMode", {}).get(sec, [])
        after, merged = new[sec], []
        for op, a1, a2, b1, b2 in difflib.SequenceMatcher(
            None, [norm(e) for e in before], after
        ).get_opcodes():
            if op == "equal":
                merged += before[a1:a2]  # an untouched entry keeps its original text
                continue
            changed = True
            for e in before[a1:a2]:
                print(f"  - {sec}: {short(e)}")
            for e in after[b1:b2]:
                print(f"  + {sec}: {short(e)}")
            removed.setdefault(sec, []).extend(before[a1:a2])
            added.setdefault(sec, []).extend(after[b1:b2])
            merged += after[b1:b2]
        settings.setdefault("autoMode", {})[sec] = merged
    for sec in SECTIONS:  # an entry both removed and added in one section was only moved
        gone, came = removed.get(sec, []), added.get(sec, [])
        removed[sec] = [e for e in gone if e not in came]
        added[sec] = [e for e in came if e not in gone]
    if not changed:
        print("no changes")
        return
    write(settings)
    n_added, n_removed = sum(map(len, added.values())), sum(map(len, removed.values()))
    show_and_commit(repo, target, settings["autoMode"], added, removed, f"{n_added} added, {n_removed} removed")
    base.write_text(json.dumps(settings["autoMode"], sort_keys=True))  # only once the commit landed


COMMANDS = {"add": cmd_add, "open": cmd_open, "apply": cmd_apply}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die("usage: automode-entry add <section> <text|-|@file> | open | apply")
    COMMANDS[sys.argv[1]](sys.argv[2:])
