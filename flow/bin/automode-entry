#!/usr/bin/env python3
"""automode-entry -- change autoMode entries in ~/.claude/settings.json in place.

  automode-entry add <section> <text|-|@file>   append one entry
  automode-entry open                           write the whole autoMode block to a document
  automode-entry apply                          diff the edited document, write, commit, push

Sections: allow, soft_deny, environment. `-` reads the text from stdin (a
heredoc), `@file` from a file; a `!` command is not known to get interactive
stdin, so there is no prompt.

`open` writes one `# <section>` heading per section and one entry per
paragraph to <primary checkout>/.scratch/automode.md: outside
`.claude/worktrees`, where Zed hides the tree and never reloads a tab. Edit it,
then `apply` prints each added (`+`) and removed (`-`) entry, writes the
settings, reads each changed rule back through `claude auto-mode config`, and
commits and pushes. `apply` refuses an unknown heading, text before the first
heading, and settings that changed since `open`.

The write goes through open(path, "w"), which follows the symlink, so
~/.claude/settings.json stays a symlink; a tmp file renamed over it would not.
The serialized text is parsed back and encoded before the file is opened, so
a refusal leaves it unchanged.
"""

import difflib
import json
import os
import subprocess
import sys
import textwrap
from pathlib import Path

SECTIONS = ("allow", "soft_deny", "environment")
LINK = Path.home() / ".claude" / "settings.json"


def die(msg):
    print(f"refused: {msg}  (file unchanged)", file=sys.stderr)
    sys.exit(1)


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)


def locate():
    """The settings file the link points at, its repo, and that repo's primary checkout."""
    target = LINK.resolve()
    top = git(target.parent, "rev-parse", "--show-toplevel")
    if top.returncode:
        die(f"{target} is not inside a git repo")
    common = git(target.parent, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return target, Path(top.stdout.strip()), Path(common.stdout.strip()).parent


def load():
    try:
        return json.loads(LINK.read_text())
    except (OSError, json.JSONDecodeError) as e:
        die(f"{LINK} does not parse: {e}")


def write(settings):
    text = json.dumps(settings, indent=2, ensure_ascii=False) + "\n"
    try:
        json.loads(text)
        data = text.encode("utf-8")  # strict: fails here, before the file is opened
    except (ValueError, UnicodeEncodeError) as e:
        die(f"the result would not be valid JSON text: {e}")
    with open(LINK, "wb") as f:  # follows the symlink
        f.write(data)
    if not LINK.is_symlink():
        print(f"WARNING: {LINK} is no longer a symlink", file=sys.stderr)
        sys.exit(1)


def norm(text):
    return " ".join(text.split())


def text_arg(arg):
    if arg == "-":
        raw = sys.stdin.buffer.read()
    elif arg.startswith("@"):
        try:
            raw = Path(arg[1:]).read_bytes()
        except OSError as e:
            die(f"cannot read {arg[1:]}: {e}")
    else:
        raw = os.fsencode(arg)
    try:
        text = norm(raw.decode("utf-8"))
    except UnicodeDecodeError as e:
        die(f"entry text is not UTF-8: {e}")
    if not text:
        die("empty entry text")
    return text


def section_of(settings, name):
    if name not in SECTIONS:
        die(f"section must be one of {', '.join(SECTIONS)}")
    return settings.setdefault("autoMode", {}).setdefault(name, ["$defaults"])


def short(entry, width=72):
    return textwrap.shorten(entry.split(":")[0] if ":" in entry[:120] else entry, width)


def show_and_commit(repo, target, added, removed, message):
    """Read each changed rule back through `claude auto-mode config`; commit and push if all agree."""
    try:
        cfg = subprocess.run(
            ["claude", "auto-mode", "config"], capture_output=True, text=True, check=True
        ).stdout
        effective = {x for v in json.loads(cfg).values() for x in v}
    except (OSError, subprocess.CalledProcessError, ValueError) as e:
        print(f"settings written, not committed: `claude auto-mode config` failed: {e}", file=sys.stderr)
        sys.exit(1)
    bad = False
    for e in added:
        ok = e in effective
        bad |= not ok
        print(f"  {'in' if ok else 'MISSING from'} claude auto-mode config: {textwrap.shorten(e, 100)}")
    for e in removed:
        ok = e not in effective
        bad |= not ok
        print(f"  {'gone from' if ok else 'STILL in'} claude auto-mode config: {textwrap.shorten(e, 100)}")
    if bad:
        print("settings written, not committed: the rule does not match `claude auto-mode config`", file=sys.stderr)
        sys.exit(1)
    for step in (
        ["commit", "-q", "-m", f"autoMode: {message}", "--", str(target)],
        ["push", "-q"],
    ):
        r = git(repo, *step)
        if r.returncode:
            print(f"settings written, `git {step[0]}` failed: {r.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
    print(f"committed and pushed: autoMode: {message}")


def cmd_add(args):
    if len(args) != 2:
        die("usage: automode-entry add <section> <text|-|@file>")
    target, repo, _ = locate()
    settings = load()
    entries = section_of(settings, args[0])
    new = text_arg(args[1])
    if new in entries:
        die(f"{args[0]} already holds that entry")
    entries.append(new)
    write(settings)
    show_and_commit(repo, target, [new], [], f"add {args[0]} entry '{short(new, 40)}'")


def doc_paths(primary):
    d = primary / ".scratch"
    return d / "automode.md", d / "automode.base.json"


def cmd_open(args):
    if args:
        die("usage: automode-entry open")
    _, _, primary = locate()
    doc, base = doc_paths(primary)
    auto = load().get("autoMode", {})
    parts = ["<!-- automode-entry: one entry per paragraph; edit, add or delete, then `automode-entry apply` -->"]
    for sec in SECTIONS:
        parts.append(f"# {sec}")
        parts += auto.get(sec, [])
    doc.parent.mkdir(parents=True, exist_ok=True)
    doc.write_text("\n\n".join(parts) + "\n")
    base.write_text(json.dumps(auto, sort_keys=True))
    print(f"edit this file, then run `automode-entry apply`:\n{doc}")
    win = subprocess.run(["wslpath", "-w", str(doc)], capture_output=True, text=True)
    if win.returncode == 0:
        print(f"Windows path: {win.stdout.strip()}")


def parse(text):
    out, cur = {}, None
    for para in text.split("\n\n"):
        para = norm(para)
        if not para or para.startswith("<!--"):
            continue
        if para.startswith("# "):
            cur = para[2:].strip()
            if cur not in SECTIONS:
                die(f"unknown section heading '# {cur}'")
            out[cur] = []
        elif cur is None:
            die("text before the first '# section' heading")
        else:
            out[cur].append(para)
    return out


def cmd_apply(args):
    if args:
        die("usage: automode-entry apply")
    target, repo, primary = locate()
    doc, base = doc_paths(primary)
    if not doc.exists() or not base.exists():
        die("run `automode-entry open` first")
    settings = load()
    if json.dumps(settings.get("autoMode", {}), sort_keys=True) != base.read_text():
        die("autoMode changed since open; run `automode-entry open` again")
    new = parse(doc.read_text())
    added, removed = [], []
    for sec in SECTIONS:
        before = settings.get("autoMode", {}).get(sec, [])
        if sec not in new:
            continue
        after, merged = new[sec], []
        for op, a1, a2, b1, b2 in difflib.SequenceMatcher(
            None, [norm(e) for e in before], after
        ).get_opcodes():
            if op == "equal":
                merged += before[a1:a2]  # an untouched entry keeps its original text
                continue
            for e in before[a1:a2]:
                print(f"  - {sec}: {short(e)}")
            for e in after[b1:b2]:
                print(f"  + {sec}: {short(e)}")
            removed += before[a1:a2]
            added += after[b1:b2]
            merged += after[b1:b2]
        settings.setdefault("autoMode", {})[sec] = merged
    if not added and not removed:
        print("no changes")
        return
    write(settings)
    base.write_text(json.dumps(settings["autoMode"], sort_keys=True))
    show_and_commit(repo, target, added, removed, f"{len(added)} added, {len(removed)} removed")


COMMANDS = {"add": cmd_add, "open": cmd_open, "apply": cmd_apply}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die("usage: automode-entry add <section> <text|-|@file> | open | apply")
    COMMANDS[sys.argv[1]](sys.argv[2:])
