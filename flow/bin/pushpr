#!/usr/bin/env bash
# Push current branch and open a PR. If you're still on the default branch,
# first cut a feature branch and commit your changes onto it.
#
# Outward gate: opens the PR only when its base repo is yours. If the base is
# someone else's (a fork's upstream, or a repo you don't own), it pushes the
# branch and stops — you open the PR after reviewing. Safe for the agent to run.
#
# Usage: pushpr [branch-name] [commit-message]
# ponytail: gh pr create --fill reuses the commit title/body — no manual args.
set -euo pipefail

base=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || echo main)
branch=$(git rev-parse --abbrev-ref HEAD)

# Still on the default branch? Two cases.
if [ "$branch" = "$base" ]; then
    dirty=false
    if ! git diff --quiet || ! git diff --cached --quiet || \
       [ -n "$(git ls-files --others --exclude-standard)" ]; then
        dirty=true
    fi

    # Clean here, but the work may live in a linked worktree (e.g. /implement
    # cuts one and commits there). Find feature branches ahead of the base and,
    # if there's exactly one, push THAT instead of cutting an empty branch off
    # the default. Refs are shared across worktrees, so no cd is needed.
    if [ "$dirty" = false ]; then
        ahead=$(git worktree list --porcelain \
            | awk '/^branch /{print substr($2,12)}' \
            | grep -vx "$base" \
            | while read -r b; do
                  [ -n "$(git rev-list "origin/$base..$b" 2>/dev/null)" ] && echo "$b"
              done || true)
        count=$(printf '%s' "$ahead" | grep -c . || true)
        if [ "$count" -eq 1 ]; then
            branch="$ahead"
            echo "pushpr: pushing worktree branch '$branch' (ahead of $base)"
        elif [ "$count" -gt 1 ]; then
            echo "pushpr: multiple worktree branches ahead of $base — cd into the one you want:" >&2
            printf '  %s\n' $ahead >&2
            exit 1
        fi
    fi

    # No worktree work found: cut a feature branch here and commit onto it.
    if [ "$branch" = "$base" ]; then
        branch=${1:-work-$(date +%Y%m%d-%H%M%S)}
        message=${2:-$branch}
        git checkout -b "$branch"
        if [ "$dirty" = true ]; then
            git add -A
            git commit -m "$message"
        fi
    fi
fi

git push -u origin "$branch"

# Outward gate + unambiguous PR target. A bare `gh repo view` / `gh pr create`
# resolves to the `upstream` remote when one exists — so it'd read/target the
# WRONG repo (e.g. a standalone repo that keeps an upstream for pulling). So
# evaluate ORIGIN explicitly and apply the fork rule: a fork's PR targets its
# parent; a standalone repo targets itself. If that target isn't yours, stop —
# the branch is pushed, but opening the PR (the act another human sees) is
# yours, after reviewing the diff.
me=$(gh api user -q .login)
target=$(gh repo view "$(git remote get-url origin)" --json owner,name,isFork,parent \
    -q 'if .isFork then (.parent.owner.login + "/" + .parent.name) else (.owner.login + "/" + .name) end')
if [ "${target%%/*}" != "$me" ]; then
    echo "pushpr: PR base repo '$target' isn't yours — branch pushed, PR is yours."
    echo "Review the diff, then run:"
    echo "  gh pr create --repo $target --head $me:$branch --base $base --fill"
    exit 0
fi

# PR already open for this branch? Nothing to do.
if gh pr view "$branch" --repo "$target" >/dev/null 2>&1; then
    echo "PR already exists:"
    gh pr view "$branch" --repo "$target" --json url -q .url
else
    gh pr create --repo "$target" --head "$me:$branch" --base "$base" --fill
fi

# Closing-keyword gap. `--fill` inherits the commits' wording, so an issue the
# diff delivers but no commit says "Closes" for survives the merge — that's how
# a PR shipped three tickets and closed one. Which mention is a delivery and
# which is just a reference isn't decidable from text (a stale "Closes" once
# closed a ticket whose work didn't exist), so list the gap; you choose.
num=$(gh pr view "$branch" --repo "$target" --json number -q .number)
closes=$(gh pr view "$branch" --repo "$target" --json title,body -q '.title, .body' \
    | grep -oiE '(close[sd]?|fix(e[sd])?|resolve[sd]?) +#[0-9]+' \
    | grep -oE '[0-9]+' | sort -u || true)
mentions=$(git log --format=%B "origin/$base..$branch" \
    | grep -oE '#[0-9]+' | tr -d '#' | sort -u || true)

missing=""
for n in $(comm -23 <(printf '%s\n' "$mentions") <(printf '%s\n' "$closes")); do
    # One call answers both questions: still open, and an issue rather than a
    # sibling PR (a PR number resolves here too, and would suggest closing it).
    kind=$(gh api "repos/$target/issues/$n" \
        -q '.state + (if .pull_request then "-pr" else "" end)' 2>/dev/null || true)
    [ "$kind" = open ] && missing="$missing $n"
done

if [ -n "$missing" ]; then
    trailers=""
    for n in $missing; do trailers="${trailers}Closes #$n\\n"; done
    echo
    echo "pushpr: open issues these commits mention but the PR does not close:"
    printf '  #%s\n' $missing
    echo "If the diff delivers one, append its trailer (drop any it only refers to):"
    echo "  { gh pr view $num --repo $target --json body -q .body; printf '\\n$trailers'; } | gh pr edit $num --repo $target --body-file -"
fi
