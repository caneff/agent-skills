#!/usr/bin/env bash
# The dispatcher for the /implement lane: turn a ticket number into a worker
# running in its own workspace inside herdr, report, and stop. It never waits
# on the worker.
#
#   implement-dispatch [--repo <path>] [--model sonnet|opus] <issue number>
#
# Refuses, with nothing claimed or created, when the issue is not open and
# labelled ready-for-agent, the herdr server is not running, claude onboarding
# is incomplete, the herdr agent name is taken, or the workspace path or branch
# already exists. After the workspace exists, any
# herdr failure exits non-zero with herdr's own error and leaves the workspace
# in place for inspection. There is no bare-claude fallback.
set -uo pipefail

repo="" model=sonnet n=""
die() { echo "implement-dispatch: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)    [ $# -ge 2 ] || die "--repo needs a value"; repo="$2"; shift 2 ;;
    --model)   [ $# -ge 2 ] || die "--model needs a value"; model="$2"; shift 2 ;;
    -h|--help) sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
    -*)        die "unknown flag: $1" ;;
    *)         [ -n "$n" ] && die "one ticket at a time"; n="$1"; shift ;;
  esac
done
case "$n" in ''|*[!0-9]*) die "name one issue number" ;; esac
case "$model" in sonnet|opus) ;; *) die "--model must be sonnet or opus, not '$model'" ;; esac
command -v jq >/dev/null 2>&1 || die "jq is not on PATH"
command -v flock >/dev/null 2>&1 || die "flock is not on PATH"

# The helper sits beside the real script, not beside its ~/.local/bin link.
src="${BASH_SOURCE[0]}"; [ -L "$src" ] && src=$(readlink -f "$src")
bin_dir="${src%/*}"; [ "$bin_dir" = "$src" ] && bin_dir=.
# shellcheck source=git-origin.sh
. "$bin_dir/git-origin.sh" || die "cannot source $bin_dir/git-origin.sh"

repo="${repo:-$PWD}"
primary=$(git -C "$repo" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
[ -n "$primary" ] || die "not a git repo: $repo"
# gh always names the repo from origin; a cwd can resolve to another remote.
slug=$(slug_of "$primary")
[[ $slug =~ ^[^/:]+/[^/:]+$ ]] || die "origin in $primary names no GitHub owner/name"
branch="implement-$n"
wt="$primary/.claude/worktrees/$branch"
# herdr caps agent names at 32 characters: cut the repo part from the right.
suffix="-$n"
repo_name="${primary##*/}"
agent="${repo_name:0:$((32 - ${#suffix}))}$suffix"

# Refusals first, so a refused run leaves nothing claimed or created.
issue=$(gh issue view "$n" --repo "$slug" --json state,labels -q '.state + " " + ([.labels[].name] | join(","))' 2>/dev/null)
[ "${issue%% *}" = OPEN ] || die "#$n is not an open issue"
# needs-info and ready-for-human are judgement calls, in-progress is someone
# else's claim: the owner relabels first.
labels=",${issue#* },"
case "$labels" in *,ready-for-agent,*) ;; *) die "#$n is not labelled ready-for-agent" ;; esac
for held in in-progress needs-info ready-for-human; do
  case "$labels" in *,"$held",*) die "#$n is labelled $held" ;; esac
done
herdr status --json 2>/dev/null | jq -e '.server.running == true' >/dev/null \
  || die "no herdr server is running (herdr status)"
jq -e '.hasCompletedOnboarding == true' "$HOME/.claude.json" >/dev/null 2>&1 \
  || die "claude onboarding is not complete in $HOME/.claude.json; a brief would land in its dialog"
# The cut name can collide with another repo's ticket; never reuse a live agent.
herdr agent get "$agent" >/dev/null 2>&1 && die "herdr agent $agent already exists"
git -C "$primary" fetch -q origin || die "git fetch failed in $primary"
if [ -e "$wt" ] || git -C "$primary" worktree list --porcelain | grep -qxF "worktree $wt"; then
  die "$wt already exists"
fi
git -C "$primary" show-ref -q --verify "refs/heads/$branch" && die "branch $branch already exists"
default=$(default_of "$primary")
git -C "$primary" show-ref -q --verify "refs/remotes/origin/$default" || die "no origin/$default to branch from"

# Past here the ticket is claimed; a failure says how to release it.
fail() { # fail <what> <herdr output>
  echo "implement-dispatch: $1 failed: $2" >&2
  [ -e "$wt" ] && echo "workspace left in place at $wt" >&2
  echo "release the ticket: gh issue edit $n --repo $slug --remove-label in-progress --add-label ready-for-agent" >&2
  exit 1
}
gh issue edit "$n" --repo "$slug" --remove-label ready-for-agent --add-label in-progress --add-assignee @me >/dev/null \
  || die "could not claim #$n"

out=$(git -C "$primary" worktree add -q --no-track -b "$branch" "$wt" "origin/$default" 2>&1) \
  || fail "git worktree add" "$out"

# Pre-accept the trust dialog for exactly this path, so the worker starts at a
# prompt. Dispatches from several repos run at once: the lock serialises their
# read, modify and rename, so none overwrites another's key.
lock="$HOME/.claude.json.implement-dispatch.lock"
out=$({
  flock -w 30 9 || { echo "timed out waiting for $lock"; exit 1; }
  tmp_json=$(mktemp "$HOME/.claude.json.XXXXXX") || exit 1
  jq --arg p "$wt" '.projects[$p].hasTrustDialogAccepted = true' "$HOME/.claude.json" > "$tmp_json" \
    && mv "$tmp_json" "$HOME/.claude.json" \
    || { rm -f "$tmp_json"; echo "jq could not rewrite $HOME/.claude.json"; exit 1; }
} 9>"$lock" 2>&1) || fail "trust pre-seed" "$out"

# --cwd names the repo: without it herdr resolves the focused workspace's repo
# and answers worktree_not_found.
out=$(herdr worktree open --cwd "$primary" --path "$wt" --label "$branch" --no-focus --trust-repository 2>&1) \
  || fail "herdr worktree open" "$out"
pane=$(printf '%s' "$out" | jq -r '.result.root_pane.pane_id // empty' 2>/dev/null)
if [ -z "$pane" ]; then
  ws=$(printf '%s' "$out" | jq -r '.result.workspace.workspace_id // empty' 2>/dev/null)
  [ -n "$ws" ] || fail "herdr worktree open" "no workspace in its response: $out"
  panes=$(herdr pane list --workspace "$ws" 2>&1) || fail "herdr pane list" "$panes"
  pane=$(printf '%s' "$panes" | jq -r '.result.panes[0].pane_id // empty' 2>/dev/null)
  [ -n "$pane" ] || fail "herdr pane list" "no pane in workspace $ws: $panes"
fi
out=$(herdr agent start "$agent" --kind claude --pane "$pane" -- --model "$model" 2>&1) \
  || fail "herdr agent start" "$out"
out=$(herdr agent prompt "$agent" "/implement $n" --wait --until working --timeout 120000 2>&1) \
  || fail "herdr agent prompt" "$out"

echo "dispatched #$n ($model)"
echo "worktree: $wt"
echo "branch:   $branch"
echo "agent:    $agent"
echo "cleanup:  cd $primary && merge-cleanup $branch --repo $primary"
