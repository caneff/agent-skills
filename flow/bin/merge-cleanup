#!/usr/bin/env bash
# The tail Chris hand-ran after every squash merge: tear the workspace down,
# delete the branch local and remote, fast-forward the primary checkout.
# Agents never merge — this runs after the merge has already happened, and it
# refuses any branch the tracker does not report as merged unless --force.
#
#   merge-cleanup [--repo <path>] <branch|PR number|PR URL> [--force] [--dry-run]
#   merge-cleanup --sweep [--root <dir>] [--yes] [--dry-run]
#
# --sweep walks every git repo one level under <dir> (default ~/src), prints
# the merged local branches it would clean with how far each is ahead of the
# default branch, and asks before touching anything — --yes answers for you,
# --dry-run never asks. Then it runs the same six steps for each and prints a
# summary table with the same ahead count beside every branch.
#
# A linked worktree is never removed while a live session is in it (a sessions
# registry pid or a herdr agent). Other idle entries under .claude/worktrees
# are listed as "stale, not removed". The herdr workspaces of removed
# worktrees close at exit, after everything else.
set -uo pipefail

repo="" branch="" pr="" sweep=0 root="" dry=0 force=0 yes=0
rows=()
removal_targets=()   # worktrees this run passed the guard for, dry runs included
removed_worktrees=() # worktrees this run removed; their herdr workspaces close at exit
die() { echo "merge-cleanup: $*" >&2; exit 1; }
skip() { echo "skipped $1 ($2)"; }
run() { # run <description> <cmd...>
  local what="$1"; shift
  if [ "$dry" = 1 ]; then echo "would $what: $*"; return 0; fi
  echo "$what"; "$@"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --repo)    repo="${2:-}"; shift 2 ;;
    --pr)      pr="${2:-}"; shift 2 ;;
    --sweep)   sweep=1; shift ;;
    --root)    root="${2:-}"; shift 2 ;;
    --force)   force=1; shift ;;
    --yes)     yes=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
    -*)        die "unknown flag: $1" ;;
    *)         [ -n "$branch$pr" ] && die "one branch at a time"
               # A bare number or a PR URL is a PR; anything else is a branch.
               case "$1" in
                 [0-9]*[!0-9]*) branch="$1" ;;
                 [0-9]*)        pr="$1" ;;
                 *://*/pull/*)  pr="${1##*/pull/}"; pr="${pr%%[!0-9]*}" ;;
                 *)             branch="$1" ;;
               esac
               shift ;;
  esac
done

# Step 1 — the repo and its default branch.
# The helper sits beside the real script, not beside its ~/.local/bin link.
src="${BASH_SOURCE[0]}"; [ -L "$src" ] && src=$(readlink -f "$src")
bin_dir="${src%/*}"; [ "$bin_dir" = "$src" ] && bin_dir=.
# shellcheck source=git-origin.sh
. "$bin_dir/git-origin.sh" || die "cannot source $bin_dir/git-origin.sh"
primary_of() { # primary_of <path> -> the repo's primary (non-linked) worktree
  git -C "$1" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p'
}

# Step 2 — is this branch actually merged? The tracker is the authority: a
# squash merge leaves none of the branch's commits in the default branch, so
# an ancestor test alone would call every squashed branch unmerged. But a
# merged PR proves only the sha it merged at: a branch that kept going after
# its PR is merged up to that head and unlanded past it, so the tip must equal
# a merged PR's head. (2026-09-13: a sweep took "a PR from this branch once
# merged" as merged and deleted 87 unlanded commits.) Without gh, fall back to
# the ancestor test — fetching first, since it reads origin/<default> and a
# stale ref there deletes a branch that is not merged.
is_merged() { # is_merged <path> <branch>
  local path="$1" b="$2" slug tip heads h
  if command -v gh >/dev/null 2>&1 && slug=$(slug_of "$path"); then
    tip=$(git -C "$path" rev-parse --verify -q "refs/heads/$b") || tip=""
    heads=$(gh pr list --repo "$slug" --head "$b" --state merged \
              --json headRefOid --jq '.[].headRefOid' 2>/dev/null) || heads=""
    for h in $heads; do [ "$h" = "$tip" ] && return 0; done
  fi
  git -C "$path" fetch -q origin 2>/dev/null
  git -C "$path" merge-base --is-ancestor "$b" "origin/$(default_of "$path")" 2>/dev/null
}

# How far a branch is past the default branch — printed beside every sweep
# deletion, so a wrong "merged" call shows up as a number, not as silence.
ahead_count() { # ahead_count <path> <branch> -> N, or ? when git cannot say
  local path="$1" b="$2" base
  base="origin/$(default_of "$path")"
  git -C "$path" show-ref -q --verify "refs/remotes/$base" || base="${base#origin/}"
  git -C "$path" rev-list --count "$base..$b" 2>/dev/null || echo "?"
}
ahead_text() { # ahead_text <path> <N> -> "N commit(s) ahead of <default>"
  local s="s"; [ "$2" = 1 ] && s=""
  echo "$2 commit$s ahead of $(default_of "$1")"
}

# Step 4's delete. `-d` first: it is the honest question, and it succeeds on a
# real merge. A squash merge leaves the branch unmerged in git's eyes, so fall
# back to `-D` — step 2 has already proved the merge by then.
delete_local() { # delete_local <path> <branch>
  local path="$1" b="$2"
  if [ "$dry" = 1 ]; then echo "would delete local branch $b"; return 0; fi
  if git -C "$path" branch -d "$b" 2>/dev/null; then
    echo "deleted local branch $b"; return 0
  fi
  echo "deleting local branch $b with -D (the squash merge left it unmerged)"
  git -C "$path" branch -D "$b"
}

# The live-session guard. Two sources, either one counts: a sessions registry
# file whose cwd is in the workspace and whose pid still answers `kill -0` (a
# dead pid is a crashed session and is ignored), or a herdr agent whose cwd is.
in_tree() { case "$1/" in "$2"/*) true ;; *) false ;; esac; }
live_sessions() { # live_sessions <worktree> -> one line per live session; 1 if herdr cannot answer
  local wt="$1" f pid cwd
  for f in "$HOME"/.claude/sessions/*.json; do
    [ -f "$f" ] || continue
    IFS=$'\t' read -r pid cwd < <(jq -r '[.pid // "", .cwd // ""] | @tsv' "$f" 2>/dev/null)
    [ -n "$pid" ] && in_tree "$cwd" "$wt" && kill -0 "$pid" 2>/dev/null && echo "pid $pid"
  done
  command -v herdr >/dev/null 2>&1 || return 0
  herdr agent list 2>/dev/null | jq -r --arg wt "$wt" '.result.agents[]
    | select(.cwd == $wt or (.cwd // "" | startswith($wt + "/")))
    | "herdr agent \(.name // .agent) (\(.pane_id))"' 2>/dev/null
}
guard_live() { # guard_live <worktree>
  local wt="$1" live
  command -v jq >/dev/null 2>&1 \
    || { echo "merge-cleanup: refusing to remove $wt — jq is not on PATH, so the sessions registry cannot be read" >&2; return 1; }
  command -v herdr >/dev/null 2>&1 || skip "the herdr agent check" "herdr is not on PATH"
  # A herdr that cannot answer cannot clear the workspace either.
  live=$(live_sessions "$wt") \
    || { echo "merge-cleanup: refusing to remove $wt — herdr agent list failed" >&2; return 1; }
  [ -z "$live" ] && return 0
  echo "merge-cleanup: refusing to remove $wt — a live session is in it: ${live//$'\n'/, }" >&2
  return 1
}

# Other workspaces under <repo>/.claude/worktrees with no live session, no
# commits ahead of the default branch and nothing on disk git does not hold
# (ignored files included — .scratch evidence is work too): listed for the
# owner, never removed. A folder there that git no longer tracks as a worktree
# is listed too, marked. This run's removal targets are not "other".
stale_worktrees() { # stale_worktrees <repo> -> one path per line
  local primary default base e live c mark
  primary=$(primary_of "$1"); default=$(default_of "$1")
  base="origin/$default"
  git -C "$primary" show-ref -q --verify "refs/remotes/$base" || base="$default"
  for e in "$primary"/.claude/worktrees/*/; do
    e="${e%/}"
    for c in "${removal_targets[@]}"; do [ "$c" = "$e" ] && continue 2; done
    if [ "$(git -C "$e" rev-parse --show-toplevel 2>/dev/null)" != "$e" ]; then
      mark=" (not a git worktree)"
    else
      mark=""
      [ "$(git -C "$e" rev-list --count "$base..HEAD" 2>/dev/null)" = 0 ] || continue
      [ -z "$(git -C "$e" status --porcelain --ignored 2>/dev/null)" ] || continue
    fi
    live=$(live_sessions "$e") && [ -z "$live" ] && echo "$e$mark"
  done
}
report_stale() { # report_stale <path>...
  local p list
  command -v jq >/dev/null 2>&1 || { skip "the stale worktree report" "jq is not on PATH"; return 0; }
  list=$(for p in "$@"; do stale_worktrees "$p"; done)
  [ -n "$list" ] || return 0
  echo
  echo "stale, not removed:"
  printf '  %s\n' "${list//$'\n'/$'\n'  }"
}

# herdr keeps its own workspace record per checkout. Once the checkout is gone,
# close the herdr workspace whose path matched, so herdr does not keep panes
# open on deleted directories. It closes every pane there, the one this runs in
# included, so close_removed_herdr_workspaces runs once, after everything else.
close_herdr_workspace() { # close_herdr_workspace <worktree>
  local wt="$1" ids id
  command -v herdr >/dev/null 2>&1 || { skip "the herdr workspace close" "herdr is not on PATH"; return 0; }
  ids=$(herdr workspace list 2>/dev/null | jq -r --arg wt "$wt" \
       '.result.workspaces[] | select(.worktree.checkout_path == $wt) | .workspace_id' 2>/dev/null)
  [ -n "$ids" ] || { skip "the herdr workspace close" "no herdr workspace at $wt"; return 0; }
  while read -r id; do
    run "closing herdr workspace $id" herdr workspace close "$id" || true
  done <<< "$ids"
}
close_removed_herdr_workspaces() {
  local wt
  for wt in "${removed_worktrees[@]}"; do close_herdr_workspace "$wt"; done
}

cleanup_branch() { # cleanup_branch <path> <branch> -> steps 3-6
  local path="$1" b="$2" primary default wt
  primary=$(primary_of "$path"); default=$(default_of "$path")
  [ "$b" = "$default" ] && { echo "merge-cleanup: refusing to delete the default branch $b" >&2; return 1; }
  if [ "$force" = 1 ]; then
    echo "--force: skipping the merged check for $b"
  elif ! is_merged "$path" "$b"; then
    echo "merge-cleanup: $b is not merged — nothing cleaned up (--force overrides)" >&2; return 1
  fi

  # Step 3 — the workspace. A linked worktree holding the branch makes `git
  # branch -d` fail with "used by worktree", so it goes first, by the path git
  # itself reports — but never while a session is still alive in it.
  wt=$(git -C "$path" worktree list --porcelain 2>/dev/null \
       | awk -v b="refs/heads/$b" '/^worktree /{p=$2} $0=="branch "b{print p; exit}')
  if [ -n "$wt" ] && [ "$wt" != "$primary" ]; then
    guard_live "$wt" || return 1
    removal_targets+=("$wt")
    run "removing the linked worktree at $wt" git -C "$path" worktree remove --force "$wt" \
      && removed_worktrees+=("$wt")
  fi
  run "pruning stale worktree entries" git -C "$path" worktree prune

  # Step 4 — the local branch. Git refuses to delete a branch a checkout holds,
  # so move the primary off it first.
  if [ -n "$primary" ] && [ "$(git -C "$primary" rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$b" ]; then
    if git -C "$primary" show-ref -q --verify "refs/heads/$default"; then
      run "switching $primary off $b onto $default" git -C "$primary" checkout -q "$default" || return 1
    else
      run "switching $primary off $b onto a fresh $default" \
        git -C "$primary" checkout -q -b "$default" --track "origin/$default" || return 1
    fi
  fi
  if git -C "$path" show-ref -q --verify "refs/heads/$b"; then
    delete_local "$path" "$b" || return 1
  else
    skip "the local branch delete" "no local $b"
  fi

  # Step 5 — the remote branch, if the merge did not already drop it.
  if git -C "$path" ls-remote --exit-code --heads origin "$b" >/dev/null 2>&1; then
    run "deleting remote branch $b" git -C "$path" push origin --delete "$b" || true
  else
    skip "the remote branch delete" "origin has no $b"
  fi

  # Step 6 — fast-forward the primary checkout, so the next branch starts from
  # the merge rather than from behind it.
  if [ -n "$primary" ] && [ "$(git -C "$primary" rev-parse --abbrev-ref HEAD 2>/dev/null)" = "$default" ]; then
    run "fast-forwarding $default in $primary" git -C "$primary" pull --ff-only --quiet || true
  else
    skip "the fast-forward" "$primary is not on $default"
  fi
}

if [ "$sweep" = 1 ]; then
  [ -n "$branch$pr" ] && die "--sweep takes no branch or PR"
  root="${root:-$HOME/src}"
  [ -d "$root" ] || die "no such root: $root"
  rc=0 repos=() plan=() header="sweep plan"
  [ "$dry" = 1 ] && header="$header (dry run)"
  # Pass 1 — the plan: every merged branch, with its distance past the default
  # branch, before anything is touched.
  for d in "$root"/*/; do
    git -C "$d" rev-parse --git-dir >/dev/null 2>&1 || continue
    repos+=("$d")
    default=$(default_of "$d")
    while read -r b; do
      [ -n "$b" ] && [ "$b" != "$default" ] || continue
      is_merged "$d" "$b" || continue
      plan+=("$d|$b|$(ahead_count "$d" "$b")")
    done < <(git -C "$d" for-each-ref --format='%(refname:short)' refs/heads/)
  done
  if [ "${#plan[@]}" -gt 0 ]; then
    echo "$header: ${#plan[@]} merged branch(es) under $root"
    for row in "${plan[@]}"; do
      IFS='|' read -r d b n <<< "$row"
      echo "  $(basename "${d%/}") $b  $(ahead_text "$d" "$n")"
    done
    # Nothing is deleted until confirmed. A closed or non-terminal stdin is
    # not a yes: an unattended sweep needs --yes on the line.
    if [ "$dry" = 0 ] && [ "$yes" = 0 ]; then
      printf 'delete these branches and their worktrees? [y/N] '
      read -r ans || ans=""
      case "$ans" in y|Y|yes|YES) ;; *) die "nothing deleted (answer y, or pass --yes)" ;; esac
    fi
  fi
  # Pass 2 — the cleanup.
  for row in "${plan[@]}"; do
    IFS='|' read -r d b n <<< "$row"
    echo "== ${d%/} $b"
    if cleanup_branch "$d" "$b"; then
      rows+=("$(basename "${d%/}")|$b|cleaned|$(ahead_text "$d" "$n")")
    else
      rows+=("$(basename "${d%/}")|$b|FAILED|$(ahead_text "$d" "$n")"); rc=1
    fi
  done
  echo
  echo "sweep summary"
  if [ "${#rows[@]}" = 0 ]; then
    echo "  nothing merged to clean up under $root"
  else
    printf '  %s\n' "${rows[@]}" | column -t -s '|' 2>/dev/null \
      || printf '  %s\n' "${rows[@]}"
  fi
  report_stale "${repos[@]}"
  close_removed_herdr_workspaces
  exit "$rc"
fi

repo="${repo:-$PWD}"
git -C "$repo" rev-parse --git-dir >/dev/null 2>&1 || die "not a git repo: $repo"
if [ -z "$branch" ] && [ -n "$pr" ]; then
  slug=$(slug_of "$repo") || die "no origin remote in $repo"
  branch=$(gh pr view "$pr" --repo "$slug" --json headRefName -q .headRefName) \
    || die "could not read PR #$pr"
  [ -n "$branch" ] || die "PR #$pr has no head branch"
  echo "PR #$pr is $branch"
fi
[ -n "$branch" ] || die "name a branch, a PR number or URL, or pass --sweep"
rc=0
cleanup_branch "$repo" "$branch" || rc=1
[ "$rc" = 1 ] || report_stale "$repo"
close_removed_herdr_workspaces
exit "$rc"
