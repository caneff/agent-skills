#!/usr/bin/env bash
# Land the current worktree branch on the repo's default branch: fetch, rebase,
# test, push, remove the worktree. Linear history, no PR — for repos you own,
# where merge review already happened. If the repo isn't yours, use `pushpr`.
#
# Test command: git config land.testcmd (e.g. `git config land.testcmd 'just
# test'`). Unset means no tests run, and land says so.
#
# Refuses before touching anything if: not in a linked worktree, on the default
# branch, the tree is dirty, or origin's owner isn't your gh login. Nothing
# reaches origin until the tests pass on the rebased branch.
#
# Conflicts are NOT auto-resolved here. On conflict land aborts the rebase,
# puts the branch back, and stops — the caller decides whether it's mechanical
# (rebase by hand, per the conflict-resolution skill) or a real collision (stop
# and report to the owner).
#
# Usage: land   (from inside the worktree)
set -euo pipefail

die() { echo "land: $*" >&2; exit 1; }

# --- refuse before touching anything ----------------------------------------

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not in a git repo."

git_dir=$(git rev-parse --absolute-git-dir)
common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd)
[ "$git_dir" != "$common_dir" ] || \
    die "not in a linked worktree — land is for a worktree branch. Use pushpr."

wt=$(git rev-parse --show-toplevel)
# The first entry of `git worktree list` is always the main working tree; that's
# where the worktree removal has to run from, since we're standing in the one
# being removed.
main_wt=$(git worktree list --porcelain | awk '/^worktree /{print substr($0,10); exit}')

branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" != HEAD ] || die "detached HEAD — check out the feature branch first."

# Default branch: the remote's HEAD if the clone recorded one, else ask gh, else
# assume main. `gh` isn't required — a file-path origin has no GitHub side.
base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
[ -n "$base" ] || base=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || true)
[ -n "$base" ] || base=main
[ "$branch" != "$base" ] || die "on the default branch '$base' — nothing to land."

if ! git diff --quiet || ! git diff --cached --quiet || \
   [ -n "$(git ls-files --others --exclude-standard)" ]; then
    die "worktree is dirty — commit or discard your changes, then run land again."
fi

# Ownership gate. Landing straight onto someone else's default branch is never
# this tool's job. A non-github.com origin (a file path, a scratch repo) is by
# definition yours, so there's nothing to check.
origin_url=$(git remote get-url origin 2>/dev/null) || die "no 'origin' remote."
case "$origin_url" in
    *github.com*)
        me=$(gh api user -q .login) || die "can't read your gh login — is gh authenticated?"
        owner=$(gh repo view "$origin_url" --json owner -q .owner.login) || \
            die "can't read origin's owner from gh."
        [ "$owner" = "$me" ] || die \
            "origin '$owner/...' isn't yours — landing on its default branch isn't this tool's job. Use pushpr."
        ;;
esac

# --- fetch, rebase ----------------------------------------------------------

echo "land: fetching origin"
git fetch --quiet origin

# --- sweep spent worktrees --------------------------------------------------
#
# A worktree whose every commit is already on origin/$base is spent: the work
# reached the default branch, so deleting it loses nothing. They pile up when a
# land can't remove its own worktree, or when a session exits and keeps one.
# Sweeping here means the next land clears them; nobody removes them by hand.
#
# Clean and merged is not enough on its own — a builder's brand-new worktree
# has no commits yet, so its HEAD is an ancestor of origin/$base too, and
# sweeping it would delete a live agent's working directory. The index mtime
# separates the two: git touches it on checkout, add, commit and status, so a
# worktree idle for an hour is abandoned, not busy.
#
# An agent session locks its worktree, and `worktree remove` refuses a locked
# one — which is why leftovers accumulated in the first place. A lock on a
# worktree that is clean, merged and idle for an hour belongs to a session that
# is gone, so the sweep releases it. Unlock, then remove *without* --force, so
# an unexpectedly dirty tree still blocks the delete.
#
# ponytail: an hour is a guess. If an agent ever gets swept mid-think, raise it
# or ask the harness which sessions are live.
git worktree list --porcelain \
    | awk '/^worktree /{w=substr($0,10)} /^branch /{print w"\t"substr($0,8)}' \
    | while IFS=$(printf '\t') read -r w ref; do
    [ "$w" != "$wt" ] && [ "$w" != "$main_wt" ] || continue
    idx=$(git -C "$w" rev-parse --absolute-git-dir 2>/dev/null)/index
    [ -z "$(find "$idx" -mmin -60 2>/dev/null)" ] || continue
    git merge-base --is-ancestor "$ref" "origin/$base" 2>/dev/null || continue
    git -C "$w" diff --quiet 2>/dev/null \
        && git -C "$w" diff --cached --quiet 2>/dev/null \
        && [ -z "$(git -C "$w" ls-files --others --exclude-standard 2>/dev/null)" ] \
        || continue
    git -C "$main_wt" worktree unlock "$w" 2>/dev/null || true
    if git -C "$main_wt" worktree remove "$w" 2>/dev/null; then
        echo "land: swept spent worktree $w"
        git -C "$main_wt" branch -q -d "${ref#refs/heads/}" 2>/dev/null || true
    fi
done

start=$(git rev-parse HEAD)
echo "land: rebasing $branch onto origin/$base"
if ! git rebase "origin/$base" >/dev/null; then
    git rebase --abort 2>/dev/null || true
    git reset --hard --quiet "$start"
    cat >&2 <<EOF
land: rebase conflict onto origin/$base — the rebase was aborted and $branch is
back at $start. Nothing was pushed. STOP AND REPORT.
  - Mechanical conflict (import lists, changelogs, generated files)? Rebase by
    hand per the conflict-resolution skill, then run land again.
  - Both sides changed the same logic? Do not guess — report it to the owner.
EOF
    exit 1
fi

# --- test -------------------------------------------------------------------

testcmd=$(git config --get land.testcmd || true)
if [ -z "$testcmd" ]; then
    echo "land: WARNING — no test command; set one with: git config land.testcmd '<cmd>'"
else
    echo "land: running tests: $testcmd"
    if ! (cd "$wt" && eval "$testcmd"); then
        die "tests failed on the rebased branch. Nothing pushed; $branch stays rebased."
    fi
fi

# --- push, then clean up ----------------------------------------------------

echo "land: pushing $branch onto origin/$base"
git push --quiet origin "HEAD:refs/heads/$base" || \
    die "push rejected — origin/$base moved since the fetch. Run land again."

# Fast-forward the local default branch wherever it's checked out, so the main
# working tree isn't left behind. Cosmetic: the push already landed.
git fetch --quiet origin
base_wt=$(git worktree list --porcelain \
    | awk -v b="refs/heads/$base" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w; exit}')
if [ -n "$base_wt" ]; then
    git -C "$base_wt" merge --ff-only --quiet "origin/$base" 2>/dev/null || \
        echo "land: WARNING — couldn't fast-forward local $base in $base_wt; pull it yourself."
elif git show-ref --quiet --verify "refs/heads/$base"; then
    # Only a true fast-forward: a diverged local $base has unpushed commits, and
    # moving its ref would orphan them.
    if git merge-base --is-ancestor "refs/heads/$base" "origin/$base"; then
        git update-ref "refs/heads/$base" "origin/$base"
    else
        echo "land: WARNING — local $base has diverged from origin/$base; not moving it."
    fi
fi

# An agent session locks the worktree it is standing in, and `worktree remove`
# refuses a locked one — that lock is why landing used to leave the directory
# behind and ask for it by hand. Running land IS the request to remove it, so
# release the lock first.
#
# Plain remove after that, never --force: an unexpectedly dirty worktree should
# block the delete, not lose work. The push already succeeded, so a failure
# here is a warning — the work is landed either way.
git -C "$main_wt" worktree unlock "$wt" 2>/dev/null || true
if git -C "$main_wt" worktree remove "$wt"; then
    echo "land: landed $branch on origin/$base; worktree removed."
    git -C "$main_wt" branch -q -d "$branch" 2>/dev/null || true
else
    echo "land: landed $branch on origin/$base."
    echo "land: WARNING — couldn't remove the worktree at $wt (git's reason is above)."
    echo "land: the next land sweeps it once it has been idle an hour. To remove it now:"
    echo "  git -C $main_wt worktree remove $wt"
fi
