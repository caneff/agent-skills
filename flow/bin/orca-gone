#!/usr/bin/env bash
# One command says whether the retired front end is fully gone. Run with no
# arguments.
#
# Greps the paths named in the removal inventory under docs/research/
# (dated 2026-09-10) for the retired name, case-insensitive, `rg -uu`
# (ignored and dotted paths included), and checks that its old worktree
# directory is absent or empty. Exits 0 with a one-line pass; else lists
# every hit and exits 1.
#
# Scope:
#   - this repo, excluding docs/research/ (the inventory and other research
#     notes name it throughout on purpose — that's the record, not a call
#     site), any node_modules/ tree, and visual-teach/assets/ — both are
#     vendored/generated code where case-insensitive substring matching
#     hits by coincidence — a minified or camelCase identifier can straddle
#     two ordinary words and spell the four letters this check looks for by
#     accident — and not a real reference
#   - both CLAUDE.md copies: this repo's flow/claude/CLAUDE.md (covered by
#     the repo scan above) and ~/.claude/CLAUDE.md
#   - regular files in ~/.local/bin (content only — a dangling symlink or an
#     empty file left at a retired name, the artifact class #715's cleanup
#     loop existed for, has no content to match and would pass unnoticed;
#     rg also does not follow symlinks by default, so the many scripts
#     symlinked in from this repo are not re-scanned here)
#   - every AGENTS.md under ~/src, following ~/src itself if it is a symlink
#
# The name this script searches for is assembled below rather than spelled
# out, here or in its test, so this file and its fixtures never flag
# themselves and never need an exclusion of their own.
set -uo pipefail

command -v rg >/dev/null 2>&1 || { echo "FAIL: rg not found on PATH"; exit 1; }

needle='or''ca'

repo_root="${GONE_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
home_claude_md="${GONE_HOME_CLAUDE_MD:-$HOME/.claude/CLAUDE.md}"
local_bin="${GONE_LOCAL_BIN:-$HOME/.local/bin}"
src_dir="${GONE_SRC_DIR:-$HOME/src}"
workspaces_dir="${GONE_WORKSPACES_DIR:-$HOME/$needle/workspaces}"

hits=""
add_hits() { # add_hits <rg output, possibly empty>
  [ -n "$1" ] && hits="$hits
$1"
}
scan() { # scan <file-or-dir>, skipped if it doesn't exist
  [ -e "$1" ] && add_hits "$(rg -uu -i -n -H "$needle" "$1" 2>/dev/null)"
}

add_hits "$(rg -uu -i -n -H "$needle" "$repo_root" \
  --glob '!docs/research/**' --glob '!**/node_modules/**' \
  --glob '!visual-teach/assets/**' 2>/dev/null)"

scan "$home_claude_md"
scan "$local_bin"

if [ -d "$src_dir" ]; then
  # cd -P resolves a symlinked $src_dir itself; find is still -P (physical)
  # for everything under it, so an internal symlink loop can't run away.
  resolved_src_dir="$(cd -P -- "$src_dir" && pwd)"
  while IFS= read -r -d '' agents_md; do
    scan "$agents_md"
  done < <(find "$resolved_src_dir" -iname AGENTS.md -print0 2>/dev/null)
fi

workspaces_left=""
if [ -e "$workspaces_dir" ] && { [ ! -d "$workspaces_dir" ] || [ -n "$(ls -A "$workspaces_dir" 2>/dev/null)" ]; }; then
  workspaces_left="$workspaces_dir is present and not empty"
fi

if [ -z "$hits" ] && [ -z "$workspaces_left" ]; then
  echo "PASS: clean"
  exit 0
fi

echo "FAIL: not clean"
[ -n "$hits" ] && printf '%s\n' "$hits" | sed '/^$/d'
[ -n "$workspaces_left" ] && echo "$workspaces_left"
exit 1
