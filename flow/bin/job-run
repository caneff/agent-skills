#!/usr/bin/env bash
# job-run — run a job so that its death leaves a record.
#
#   job-run --name <name> [--group <group>] [--timeout <seconds>] [--stdin] -- <command> [args...]
#   job-run --check -- <command> [args...]
#   job-run --status <name>
#   job-run --wait <name>
#
# A background job that is SIGKILLed cannot report anything on the way down, so
# the only survivable account of it is what reached disk before it died. job-run
# owns a directory per run under ~/.cache/agent-jobs/<name>/ — never inside a
# repo — holding:
#
#   cmd      the command as invoked
#   progress the job's stdout and stderr, tee'd through, one timestamped line each
#            — tee'd, so the job's own output still reaches the caller unchanged;
#            stderr is merged into stdout on the way, as it is for any job whose
#            output is read back as one stream
#   pid      the wrapper's pid, so a later reader can ask whether it is still alive
#   session  the id of the Claude Code session that started the run
#            ($CLAUDE_CODE_SESSION_ID), empty when none did; the job-wake mod
#            (flow/mods/job-wake/) finds a session's own jobs by it, and keeps
#            its own `woken-*` markers beside it
#   group    the run's job group, present only when --group named one. The
#            job-wake mod wakes the session once for a group — when the last
#            member ends, or the first one fails (killed, rc not 0) — instead of
#            once per member. A failure line in a member's output wakes it too,
#            and the group still wakes at its end, as an ungrouped run does.
#            Start every member in the same step: the mod counts the members it
#            has seen, so one that ends before the next is launched is a group
#            of its own. A name is the group; use another for another run.
#   exit     written only when the wrapper observes the job end: rc, cause, ended
#
# The wrapper traps EXIT, TERM and INT. SIGKILL cannot be trapped, so a killed
# run simply leaves no `exit` file, and that absence is the signal `--status`
# reads. There is deliberately no heartbeat process: it would be killed by the
# same event that kills the job, and the progress timestamps already show
# staleness.
#
# $JOB_PROGRESS is exported into the job, naming the progress file, so a job can
# append its own structured lines beside the tee'd output.
#
# Progress capture is capped at about 10 MiB (PROGRESS_CAP below; counted per
# line as its length plus the timestamp, so the bound is close, not exact).
# Past the cap one
# notice line is written and further output is dropped; the job keeps running and
# its output keeps flowing to the caller. Readers use `--status` or a tail, not
# the whole file.
#
# `--wait <name>` blocks until the run is no longer alive, then prints the line
# `--status` would print and exits with the same code — never 10. Launch it as a
# `run_in_background` Bash call right after starting the job: the harness wakes
# the session when it returns, and a Monitor's expiry never applies. It rechecks
# the run directory every WAIT_INTERVAL seconds and writes nothing. A TERM or INT
# while waiting prints `interrupted <name>` and exits 13, so an interrupted wait
# is never read as an ended run. Two gaps, stated so nobody reads them as
# guarantees: a wait that runs before job-run has recorded its start answers
# from the state it finds (`unknown`, 12, for a new name; the previous run's
# verdict for a reused one), so start the job first; and a recycled pid keeps
# `alive` true, so a wait on a run whose pid was reused blocks until that
# process ends.
#
# The job's stdin is /dev/null by default: a job that reads it sees EOF at once
# instead of waiting on a pipe nothing will close (a probe stalled 33 minutes
# that way, #1698). `--stdin` hands the job the caller's stdin, for a job that
# is fed through a pipe.
#
# A job also has a wall-clock limit, DEFAULT_TIMEOUT seconds (3600), set per run
# with `--timeout <seconds>` or for the shell with $JOB_RUN_TIMEOUT; `0` means no
# limit. A job still running at the limit gets TERM (its descendants too), and
# KILL after KILL_GRACE seconds; the run records `rc=124 cause=timeout`, so the
# job-wake mod names it as timed out. A long job, a drain run among them, passes
# `--timeout 0` or its own bound.
#
# The clock runs while the job is paused (SIGSTOP), so a hunt reprioritised that
# way still counts toward its limit.
#
# A shell run as `sh|bash|dash|zsh|ksh -c '<script>'` whose script ends in a
# top-level `&` is refused: the wrapper waits on its direct child only, so that
# child returns at once and the wake fires before the work ends (#1901). Drop the
# `&`. Only that shape is read: an `&` in another program's argument is data, and
# `& disown` is not seen. The same shape of script is also refused when it polls
# (#1705; `refuse_poll_loop` says which shapes). `--check -- <command>` runs these
# two tests and nothing else (exit 0 fine, 1 trailing &, 2 poll loop, message on
# stderr), so the wrap hook asks job-run instead of keeping a copy.
#
# Otherwise job-run records and does not prevent. No setsid, no detaching, no
# keep-alive.
set -uo pipefail

PROGRESS_CAP=$((10 * 1024 * 1024))
WAIT_INTERVAL=3
DEFAULT_TIMEOUT=3600
KILL_GRACE=${JOB_RUN_KILL_GRACE:-5}

die() { echo "job-run: $*" >&2; exit 1; }

# The one place "is this run still running" is asked; prune, the name-collision
# refusal and --status all read it here.
alive() { # alive <run dir>
  local p; p=$(cat "$1/pid" 2>/dev/null)
  [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

name="" status="" wait_for="" group="" group_given=0 timeout="${JOB_RUN_TIMEOUT:-$DEFAULT_TIMEOUT}" pass_stdin=0 check_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name)    [ $# -ge 2 ] || die "--name needs a value"; name="$2"; shift 2 ;;
    --group)   [ $# -ge 2 ] || die "--group needs a value"; group="$2"; group_given=1; shift 2 ;;
    --timeout) [ $# -ge 2 ] || die "--timeout needs a value"; timeout="$2"; shift 2 ;;
    --stdin)   pass_stdin=1; shift ;;
    --check)   check_only=1; shift ;;
    --status)  [ $# -ge 2 ] || die "--status needs a value"; status="$2"; shift 2 ;;
    --wait)    [ $# -ge 2 ] || die "--wait needs a value"; wait_for="$2"; shift 2 ;;
    -h|--help) sed -n '2,${/^#/!q;s/^# \{0,1\}//p;}' "$0"; exit 0 ;;
    --)        shift; break ;;
    -*)        die "unknown flag: $1" ;;
    *)         die "unexpected argument: $1 (put the command after --)" ;;
  esac
done

jobs_dir="$HOME/.cache/agent-jobs"

# A run name is one directory name under jobs_dir and nothing else. Unchecked it
# is a path traversal — `--name ../../x` writes a run outside the cache — and
# "never inside a repo" has to be enforced, not merely claimed.
check_name() { # check_name <value> [<flag>]
  case "$1" in
    *[!A-Za-z0-9._-]*) die "${2:---name} may hold only letters, digits, dot, dash and underscore: '$1'" ;;
    .|..)              die "${2:---name} may not be '$1'" ;;
  esac
}

# --- --status and --wait ----------------------------------------------------
# One line, and an exit status a caller can branch on without parsing it:
#   0 finished (an exit record exists)  10 alive  11 killed  12 no such run
# The three live above the range bash and `die` use for their own failures, so a
# caller's `case $?` cannot read "the interpreter fell over" as "still running".
# --wait adds 13: interrupted while waiting, the run's state not known.
# `verdict` is the one place that line and code are produced; --wait loops on it.
verdict() { # verdict <name> ; prints the line, returns the code
  local n="$1" dir="$jobs_dir/$1" up=0 rc cause ended pid last
  [ -d "$dir" ] || { echo "unknown $n: no run directory at $dir"; return 12; }
  # Liveness is read before the exit record: a wrapper writes `exit` and only
  # then dies, so a pid seen dead has its record on disk already. Reading them
  # the other way round reports a run that ended between the two as killed.
  alive "$dir" && up=1
  if [ -e "$dir/exit" ]; then
    rc=$(sed -n 's/^rc=//p' "$dir/exit")
    cause=$(sed -n 's/^cause=//p' "$dir/exit")
    ended=$(sed -n 's/^ended=//p' "$dir/exit")
    echo "finished $n rc=$rc cause=$cause ended=$ended"
    return 0
  fi
  pid=$(cat "$dir/pid" 2>/dev/null)
  # A run directory with neither a pid nor an exit record is a run between its
  # `mkdir` and its pid write (below), not a dead one: answering `killed` would
  # end a --wait on a job that has not yet started.
  if [ ! -e "$dir/pid" ]; then
    echo "starting $n: run directory exists, no pid recorded yet"
    return 10
  fi
  if [ "$up" = 1 ]; then
    echo "alive $n pid=$pid last=$(tail -n 1 "$dir/progress" 2>/dev/null | cut -d' ' -f1)"
    return 10
  fi
  last=$(tail -n 1 "$dir/progress" 2>/dev/null)
  echo "killed $n pid=${pid:-?} gone with no exit record; last progress: ${last:-<none>}"
  return 11
}

[ "$group_given" = 1 ] && [ -n "$status" ] && die "--group cannot be combined with --status"
[ "$group_given" = 1 ] && [ -n "$wait_for" ] && die "--group cannot be combined with --wait"
[ -n "$status" ] && [ -n "$wait_for" ] && die "--wait cannot be combined with --status"
if [ -n "$wait_for" ]; then
  [ -n "$name" ] && die "--wait cannot be combined with --name"
  [ $# -eq 0 ] || die "--wait cannot be combined with a command"
fi

if [ -n "$status" ]; then
  check_name "$status"
  verdict "$status"; exit $?
fi

if [ -n "$wait_for" ]; then
  check_name "$wait_for"
  # A trap runs only once the foreground command returns, so the pause is a
  # background sleep waited on: the signal then interrupts `wait` at once.
  nap=""
  trap 'trap - TERM INT; [ -n "$nap" ] && kill "$nap" 2>/dev/null; echo "interrupted $wait_for: stopped waiting, the run was not observed to end"; exit 13' TERM INT
  while :; do
    line=$(verdict "$wait_for"); v=$?
    [ "$v" = 10 ] || { printf '%s\n' "$line"; exit "$v"; }
    sleep "$WAIT_INTERVAL" & nap=$!
    wait "$nap" 2>/dev/null
  done
fi

# The one place a shell script is judged (#1901, #1705). Only
# `<shell> -c <script>` is read, behind any `env`, `nohup`, `time` or
# `timeout <duration>` prefix: elsewhere an & or a sleep is an argument's own
# data. Two refusals: a poll loop (exit 2, so the wrap hook can tell a denial
# from a pass-through) and a trailing & (exit 1). The poll loop is judged first,
# so a loop ending in & is denied and never passed through to run unwrapped.
refuse_script() { # refuse_script <command> [args...]
  while :; do
    case "${1##*/}" in
      env|nohup|time|command|exec) shift ;;
      timeout) shift; while [[ ${1-} == -* ]]; do shift; done; shift ;;
      *) break ;;
    esac
    [ $# -gt 0 ] || return 0
  done
  case "${1##*/}" in sh|bash|dash|zsh|ksh) ;; *) return 0 ;; esac
  shift
  local script
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|-[a-zA-Z]*c) script="${2-}"; break ;;
      -*) shift ;;
      *) return 0 ;;
    esac
  done
  [ -n "${script-}" ] || return 0
  script="${script%"${script##*[![:space:]]}"}"
  refuse_poll_loop "$script"
  case "$script" in
    *'&&') ;;
    *'&') die "the script ends in a trailing &: job-run waits on its direct child, which returns at once, so the wake fires before the work ends. Drop the & (running job-run itself in the background is what backgrounds it)" ;;
  esac
}

# A poll loop in a job is the spin the no-poll rule bans, with the wrapper
# hiding it from the session (#1705). Read: an `until`/`while` loop that sleeps
# in its condition or its body, a `for` loop that both sleeps and `break`s (a
# poll that gives up after N tries; a `for` that only paces itself is not one),
# or a `sleep` chained straight into `gh run watch`. A `while read` loop pacing
# itself is not a condition poll. The text after the script's last `done` is
# outside every loop. It is a text match, so a quoted mention of the same shape
# is refused too; the cure is the same (use the tool, or reword).
refuse_poll_loop() { # refuse_poll_loop <script>
  local s="$1" msg nl=$'\n' lead='(^|[^[:alnum:]_.-])'
  local loop="$lead(until|while)[[:space:]]+(![[:space:]]*)?sleep[[:space:]]|$lead(until|while)[[:space:]].*[;$nl][[:space:]]*do[[:space:]].*sleep[[:space:]]"
  local forloop="${lead}for[[:space:]].*[;$nl][[:space:]]*do[[:space:]].*(sleep[[:space:]].*break|break.*sleep[[:space:]])"
  local watch='(^|[;&|({[:space:]])sleep[[:space:]]+[^[:space:];&|]+[[:space:]]*(&&|;)[[:space:]]*gh[[:space:]]+run[[:space:]]+watch'
  s=$(printf '%s' "$s" | sed -E 's/(^|[^[:alnum:]_.-])while[[:space:]]+(IFS=[^[:space:]]*[[:space:]]+)?read[[:space:]]/\1for /g')
  local body=${s%done*}
  if [[ $body =~ $loop || $body =~ $forloop || $s =~ $watch ]]; then
    msg="this script polls (a loop that sleeps, or a sleep before a watch): wrapping it in a job hides the spin, it does not remove it. Wait on the thing itself: python3 ~/.agents/skills/implement/pr_settle.py <pr> --repo <owner/name> for a PR's checks, gh run watch <run-id> for a run, job-run --wait <name> for another job"
    [ "$check_only" = 1 ] && { echo "job-run: $msg" >&2; exit 2; }
    die "$msg"
  fi
}
if [ "$check_only" = 1 ]; then
  [ $# -gt 0 ] || die "no command: put it after --"
  refuse_script "$@"; exit 0
fi

[ -n "$name" ] || die "--name is required and is never auto-generated (a path you cannot predict is a path you lose to a context summary)"
check_name "$name"
[ "$group_given" = 1 ] && { [ -n "$group" ] || die "--group may not be empty"; check_name "$group" --group; }
[ $# -gt 0 ] || die "no command: put it after --"
case "$timeout" in
  ''|*[!0-9]*) die "--timeout (or JOB_RUN_TIMEOUT) must be a whole number of seconds, 0 for none: '$timeout'" ;;
esac
refuse_script "$@"
dir="$jobs_dir/$name"

# Retention, on every start, so nobody has to remember it: a run directory
# nothing has touched for 14 days goes — measured on the newest file inside the
# run, because appending to progress never updates the directory's own mtime and
# keying on that would prune the killed records first. That kills the stale-read
# directly: an agent reading a progress file a job left under this name weeks ago.
# A live run is never pruned however old, and a prune that cannot finish must
# not stop the job it was launched alongside.
prune() {
  local d
  for d in "$jobs_dir"/*/; do
    [ -d "$d" ] || continue
    alive "$d" && continue
    [ -z "$(find "$d" -maxdepth 1 -newermt '14 days ago' -print -quit 2>/dev/null)" ] \
      && rm -rf "$d"
  done
  return 0
}

# A name collision against a live pid is a refusal, never a quietly different
# name: the path the caller predicted has to be the path that exists. Against a
# dead pid the directory is reused, because a rerun after a kill is the common
# case and must just work.
if [ -d "$dir" ] && alive "$dir"; then
  die "run '$name' is already live (pid $(cat "$dir/pid"), progress $dir/progress). Choose another --name; job-run never picks one for you."
fi

mkdir -p "$dir" || die "cannot create $dir"

# The previous run's pid and exit record go together, then the new pid lands: a
# `--wait` racing this start sees `starting`, never the old run's verdict.
rm -f "$dir/exit" "$dir/pid" "$dir/group" "$dir/timed_out"
# Everything a reader pairs with the pid lands before it, so a new pid never
# sits beside the previous run's output or owner.
: > "$dir/progress"
printf '%s\n' "${CLAUDE_CODE_SESSION_ID:-}" > "$dir/session"
[ -n "$group" ] && printf '%s\n' "$group" > "$dir/group"
printf '%s\n' "$$" > "$dir/pid"
printf '%s\n' "$*" > "$dir/cmd"
# Pruned only now that this run is recorded alive, so the directory a waiter is
# looking at is complete before the sweep's time is spent.
prune >/dev/null 2>&1 || true
export JOB_PROGRESS="$dir/progress"

# Tee, not capture: every line goes on to the caller unchanged — a wrapped job
# has to look exactly like the unwrapped one to whatever reads its output — and a
# timestamped copy goes to progress. Past the cap the copy stops and the
# pass-through does not; a `head -c` here would SIGPIPE the job it is supposed to
# be recording, so the cap is counted rather than enforced by a closed pipe.
tee_through() {
  # bash's own printf for the timestamp, not a `date` fork per line: forking
  # capped the tee at roughly a thousand lines a second, slow enough that a
  # chatty job outran the drain below and silently lost its tail.
  export TZ=UTC
  local written=0 capped=0 line
  while IFS= read -r line || [ -n "$line" ]; do
    printf '%s\n' "$line"
    [ "$capped" = 1 ] && continue
    written=$((written + ${#line} + 21))
    if [ "$written" -gt "$PROGRESS_CAP" ]; then
      printf '%(%Y-%m-%dT%H:%M:%SZ)T [job-run] progress capped at %s bytes; further output dropped\n' \
        -1 "$PROGRESS_CAP" >> "$JOB_PROGRESS"
      capped=1
      continue
    fi
    printf '%(%Y-%m-%dT%H:%M:%SZ)T %s\n' -1 "$line" >> "$JOB_PROGRESS"
  done
}

pipe="$dir/.pipe"
rm -f "$pipe"
mkfifo "$pipe" || die "cannot create $pipe"

rc=0 child="" recorded=0 timed_out=0

record() {
  [ "$recorded" = 1 ] && return
  recorded=1
  # The cause comes from what the job returned, never from what the wrapper was
  # asked to do: a job that ran to completion while a TERM was on its way is a
  # job that exited. rc above 128 is a death by signal, named rather than left
  # as arithmetic for the reader.
  local cause=exit signame
  if [ "$timed_out" = 1 ]; then
    cause=timeout
  elif [ "$rc" -gt 128 ] 2>/dev/null; then
    signame=$(kill -l $((rc - 128)) 2>/dev/null) && [ -n "$signame" ] && cause="$signame"
  fi
  printf 'rc=%s\ncause=%s\nended=%s\n' "$rc" "$cause" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$dir/exit"
}

# Forward the signal to the job and go on waiting. A job that ignores it keeps
# the wrapper alive, which is the truth: a signal sent to the wrapper is only
# forwarded. The one thing job-run enforces is the time limit below.
stop() { [ -n "$child" ] && kill -"$1" "$child" 2>/dev/null; }
trap 'stop INT' INT
trap 'stop TERM' TERM
trap 'rm -f "$pipe"; record' EXIT

tee_through < "$pipe" &
cap_pid=$!
# The job's stdin: /dev/null by default, so a reader sees EOF. With --stdin it is
# this shell's own (bash would give an async command /dev/null regardless), so a
# job fed through a pipe sees what the unwrapped job would.
if [ "$pass_stdin" = 1 ]; then exec 3<&0; else exec 3</dev/null; fi
"$@" > "$pipe" 2>&1 <&3 &
child=$!
exec 3<&-

# Wall-clock limit. The watchdog is a subshell that sleeps, then signals the
# job's whole tree; `timed_out` is its only report. It is killed, sleep and all,
# the moment the job ends, so a short job leaves nothing behind.
tree() { # tree <pid> ; the pid and every descendant, one per line
  local k; echo "$1"
  for k in $(pgrep -P "$1" 2>/dev/null); do tree "$k"; done
}
signal_tree() { local p; for p in $(tree "$child"); do kill -"$1" "$p" 2>/dev/null; done; }
wd="" wrapper=$$
if [ "$timeout" -gt 0 ]; then
  (
    sleep "$timeout" || exit 0
    # A wrapper SIGKILLed before the limit leaves this watchdog behind: it acts
    # only for a wrapper still alive, so it can never stamp a later run's dir or
    # signal a recycled pid.
    kill -0 "$wrapper" 2>/dev/null || exit 0
    : > "$dir/timed_out"
    signal_tree TERM
    sleep "$KILL_GRACE" || exit 0
    signal_tree KILL
  ) >/dev/null 2>&1 </dev/null &
  wd=$!
fi
# A trapped signal interrupts `wait`, so wait again until the child is reaped.
# Whatever it returns then is the job's own status, 127 (command not found)
# included — that is how a mistyped background job most often dies.
while :; do
  wait "$child"; w=$?
  kill -0 "$child" 2>/dev/null && continue
  rc=$w
  break
done
if [ -n "$wd" ]; then
  # The watchdog's sleep first, so killing the subshell leaves no orphan; the
  # subshell treats a killed sleep as "job ended" and exits quietly.
  pkill -P "$wd" 2>/dev/null; kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
  if [ -e "$dir/timed_out" ]; then rc=124; timed_out=1; fi
  rm -f "$dir/timed_out"
fi
# Drain the tee, but bounded: a grandchild that inherited the pipe and outlived
# the job would otherwise hold the exit record hostage for as long as it runs,
# which is exactly the silence this script exists to end. Cutting the drain
# short is said out loud, so a missing tail is never a silent one.
for _ in $(seq 1 20); do kill -0 "$cap_pid" 2>/dev/null || break; sleep 0.1; done
if kill -0 "$cap_pid" 2>/dev/null; then
  kill "$cap_pid" 2>/dev/null
  # `date -u` here, not printf's %()T: TZ=UTC is set inside tee_through's own
  # subshell and never reaches this one, so a %()T stamp would be local time
  # wearing a Z and would sort before the lines above it.
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "[job-run] a child outlived the job and still holds its output; the record stops here" \
    >> "$JOB_PROGRESS"
fi

record
exit "$rc"
