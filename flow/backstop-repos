# The repos the nightly backstop runs: one checkout per line, `~/` is
# the home directory, `#` starts a comment, blank lines are skipped. Adding or
# removing a repo is one line here; bin/backstop-nightly reads this file.
# Optional second field: `<checkout> workflow=<file name>` names the repo's
# full-gate workflow (e.g. `workflow=gate.yml`); the backstop then reads that
# repo's result from CI instead of running its seam locally. A repo with no
# field runs its seam locally.
~/.agents/skills
~/src/sudokumaker-custom-constraints workflow=ci.yml
~/src/grid-hunts workflow=ci.yml
~/src/twitch-rules-scroller
